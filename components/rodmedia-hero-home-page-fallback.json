=\\\"50\\\" x2=\\\"18.8\\\" y2=\\\"68\\\"/>\\n    <line class=\\\"rm-hero__hub-line\\\" data-i=\\\"5\\\" x1=\\\"50\\\" y1=\\\"50\\\" x2=\\\"18.8\\\" y2=\\\"32\\\"/>\\n    <circle cx=\\\"50\\\" cy=\\\"50\\\" r=\\\"7\\\" class=\\\"rm-hero__hub-core\\\"/>\\n  </svg>\\n\\n  <div class=\\\"rm-hero__hub-center\\\">rodmedia<span>.es</span></div>\\n\\n  <button type=\\\"button\\\" class=\\\"rm-hero__hub-node\\\" data-i=\\\"0\\\" style=\\\"left:50%;top:14%;\\\">\\n    <span class=\\\"rm-hero__hub-icon\\\" aria-hidden=\\\"true\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/><path d=\\\"M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/></svg>\\n    </span>\\n    <span class=\\\"rm-hero__hub-label\\\">Dominio</span>\\n  </button>\\n\\n  <button type=\\\"button\\\" class=\\\"rm-hero__hub-node\\\" data-i=\\\"1\\\" style=\\\"left:81.2%;top:32%;\\\">\\n    <span class=\\\"rm-hero__hub-icon\\\" aria-hidden=\\\"true\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\"><rect x=\\\"3\\\" y=\\\"4.5\\\" width=\\\"18\\\" height=\\\"13\\\" rx=\\\"1.6\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/><path d=\\\"M8 20.5h8M12 17.5v3\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>\\n    </span>\\n    <span class=\\\"rm-hero__hub-label\\\">Web</span>\\n  </button>\\n\\n  <button type=\\\"button\\\" class=\\\"rm-hero__hub-node\\\" data-i=\\\"2\\\" style=\\\"left:81.2%;top:68%;\\\">\\n    <span class=\\\"rm-hero__hub-icon\\\" aria-hidden=\\\"true\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\"><path d=\\\"M6 8h12l-1 12.5a1.5 1.5 0 0 1-1.5 1.5h-7a1.5 1.5 0 0 1-1.5-1.5L6 8Z\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/><path d=\\\"M9 8V6a3 3 0 0 1 6 0v2\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/></svg>\\n    </span>\\n    <span class=\\\"rm-hero__hub-label\\\">Tienda online</span>\\n  </button>\\n\\n  <button type=\\\"button\\\" class=\\\"rm-hero__hub-node\\\" data-i=\\\"3\\\" style=\\\"left:50%;top:86%;\\\">\\n    <span class=\\\"rm-hero__hub-icon\\\" aria-hidden=\\\"true\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\"><rect x=\\\"3.5\\\" y=\\\"4\\\" width=\\\"17\\\" height=\\\"6.5\\\" rx=\\\"1.4\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/><rect x=\\\"3.5\\\" y=\\\"13.5\\\" width=\\\"17\\\" height=\\\"6.5\\\" rx=\\\"1.4\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/><circle cx=\\\"7\\\" cy=\\\"7.25\\\" r=\\\"1\\\" fill=\\\"currentColor\\\"/><circle cx=\\\"7\\\" cy=\\\"16.75\\\" r=\\\"1\\\" fill=\\\"currentColor\\\"/></svg>\\n    </span>\\n    <span class=\\\"rm-hero__hub-label\\\">Hosting</span>\\n  </button>\\n\\n  <button type=\\\"button\\\" class=\\\"rm-hero__hub-node\\\" data-i=\\\"4\\\" style=\\\"left:18.8%;top:68%;\\\">\\n    <span class=\\\"rm-hero__hub-icon\\\" aria-hidden=\\\"true\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\"><path d=\\\"M3 10.5 20 4l-4.5 17-4-7-7-3.5Z\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linejoin=\\\"round\\\"/></svg>\\n    </span>\\n    <span class=\\\"rm-hero__hub-label\\\">Marketing</span>\\n  </button>\\n\\n  <button type=\\\"button\\\" class=\\\"rm-hero__hub-node\\\" data-i=\\\"5\\\" style=\\\"left:18.8%;top:32%;\\\">\\n    <span class=\\\"rm-hero__hub-icon\\\" aria-hidden=\\\"true\\\">\\n      <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\"><rect x=\\\"3\\\" y=\\\"5.5\\\" width=\\\"18\\\" height=\\\"13\\\" rx=\\\"1.6\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"/><path d=\\\"m4 7 8 6 8-6\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/></svg>\\n    </span>\\n    <span class=\\\"rm-hero__hub-label\\\">Correo</span>\\n  </button>\\n\\n  <div class=\\\"rm-hero__hub-caption\\\">\\n    <strong class=\\\"rm-hero__hub-caption-title\\\">Dominio</strong>\\n    <span class=\\\"rm-hero__hub-caption-text\\\">Tu .es o .com, gestionado por nosotros.</span>\\n  </div>\\n</div>\\n\\n<style>\\n  .rm-hero-section {\\n    position: relative;\\n    overflow: hidden;\\n  }\\n\\n  .rm-hero__bg {\\n    position: absolute;\\n    inset: 0;\\n    z-index: -10;\\n    overflow: hidden;\\n    pointer-events: none;\\n  }\\n\\n  .rm-hero__topline {\\n    position: absolute;\\n    top: 0;\\n    left: 0;\\n    right: 0;\\n    height: 3px;\\n    background: linear-gradient(90deg, #3a7bd5, #e8531a, #3a7bd5);\\n    background-size: 200% 100%;\\n    animation: rm-hero-shimmer 6s linear infinite;\\n  }\\n\\n  @keyframes rm-hero-shimmer {\\n    0% { background-position: 0% 0; }\\n    100% { background-position: 200% 0; }\\n  }\\n\\n  .rm-hero__particles {\\n    position: absolute;\\n    inset: 0;\\n    width: 100%;\\n    height: 100%;\\n    display: block;\\n  }\\n\\n  .rm-hero__glow {\\n    position: absolute;\\n    border-radius: 50%;\\n    filter: blur(110px);\\n    opacity: 0.28;\\n    animation: rm-hero-float 16s ease-in-out infinite;\\n  }\\n\\n  .rm-hero__glow--blue {\\n    width: 520px;\\n    height: 520px;\\n    top: -160px;\\n    left: -120px;\\n    background: #3a7bd5;\\n  }\\n\\n  .rm-hero__glow--orange {\\n    width: 460px;\\n    height: 460px;\\n    bottom: -180px;\\n    right: -120px;\\n    background: #e8531a;\\n    animation-delay: -8s;\\n  }\\n\\n  @keyframes rm-hero-float {\\n    0%, 100% { transform: translate(0, 0) scale(1); }\\n    50% { transform: translate(30px, 24px) scale(1.08); }\\n  }\\n\\n  /* ---------- Panel hub ---------- */\\n  .rm-hero__panel {\\n    position: relative;\\n    width: 100%;\\n    max-width: 420px;\\n    aspect-ratio: 1 / 1;\\n    margin: 0 auto;\\n    border-radius: 24px;\\n    background: rgba(255, 255, 255, 0.03);\\n    border: 1px solid rgba(255, 255, 255, 0.08);\\n    backdrop-filter: blur(16px);\\n    -webkit-backdrop-filter: blur(16px);\\n  }\\n\\n  .rm-hero__hub-lines {\\n    position: absolute;\\n    inset: 0;\\n    width: 100%;\\n    height: 100%;\\n  }\\n\\n  .rm-hero__hub-line {\\n    stroke: rgba(148, 163, 184, 0.28);\\n    stroke-width: 0.4;\\n    transition: stroke 0.5s ease, stroke-width 0.5s ease;\\n  }\\n\\n  .rm-hero__hub-line.is-active {\\n    stroke: url(#rmHubActive);\\n    stroke-width: 0.7;\\n  }\\n\\n  .rm-hero__hub-core {\\n    fill: #12121f;\\n    stroke: rgba(255, 255, 255, 0.18);\\n    stroke-width: 0.4;\\n  }\\n\\n  .rm-hero__hub-center {\\n    position: absolute;\\n    left: 50%;\\n    top: 50%;\\n    transform: translate(-50%, -50%);\\n    font-family: \\\"Inter\\\", -apple-system, sans-serif;\\n    font-size: 11px;\\n    font-weight: 600;\\n    letter-spacing: 0.01em;\\n    color: #f4f4fa;\\n    white-space: nowrap;\\n    pointer-events: none;\\n  }\\n\\n  .rm-hero__hub-center span {\\n    color: #7dd3fc;\\n  }\\n\\n  .rm-hero__hub-node {\\n    position: absolute;\\n    transform: translate(-50%, -50%);\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    gap: 6px;\\n    width: 78px;\\n    padding: 10px 4px;\\n    background: transparent;\\n    border: none;\\n    cursor: pointer;\\n    font-family: \\\"Inter\\\", -apple-system, sans-serif;\\n  }\\n\\n  .rm-hero__hub-icon {\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    width: 40px;\\n    height: 40px;\\n    border-radius: 50%;\\n    background: rgba(15, 15, 30, 0.6);\\n    border: 1px solid rgba(255, 255, 255, 0.12);\\n    color: #a9b4d0;\\n    transition: color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;\\n  }\\n\\n  .rm-hero__hub-icon svg {\\n    width: 18px;\\n    height: 18px;\\n  }\\n\\n  .rm-hero__hub-label {\\n    font-size: 11px;\\n    font-weight: 500;\\n    color: #7d84a0;\\n    text-align: center;\\n    line-height: 1.2;\\n    transition: color 0.4s ease;\\n  }\\n\\n  .rm-hero__hub-node.is-active .rm-hero__hub-icon {\\n    color: #fff;\\n    border-color: transparent;\\n    background: linear-gradient(135deg, #3a7bd5, #e8531a);\\n    box-shadow: 0 0 0 4px rgba(58, 123, 213, 0.18), 0 8px 24px rgba(232, 83, 26, 0.3);\\n    transform: scale(1.08);\\n  }\\n\\n  .rm-hero__hub-node.is-active .rm-hero__hub-label {\\n    color: #f4f4fa;\\n  }\\n\\n  .rm-hero__hub-caption {\\n    position: absolute;\\n    left: 50%;\\n    bottom: -46px;\\n    transform: translateX(-50%);\\n    width: max-content;\\n    max-width: 90%;\\n    display: flex;\\n    align-items: baseline;\\n    gap: 8px;\\n    text-align: center;\\n    font-family: \\\"Inter\\\", -apple-system, sans-serif;\\n  }\\n\\n  .rm-hero__hub-caption-title {\\n    font-size: 13px;\\n    font-weight: 600;\\n    color: #f4f4fa;\\n  }\\n\\n  .rm-hero__hub-caption-text {\\n    font-size: 12px;\\n    color: #7d84a0;\\n  }\\n\\n  @media (max-width: 980px) {\\n    .rm-hero__panel {\\n      max-width: 340px;\\n    }\\n    .rm-hero__hub-node {\\n      width: 64px;\\n    }\\n    .rm-hero__hub-icon {\\n      width: 34px;\\n      height: 34px;\\n    }\\n    .rm-hero__hub-icon svg {\\n      width: 15px;\\n      height: 15px;\\n    }\\n    .rm-hero__hub-label {\\n      font-size: 10px;\\n    }\\n  }\\n\\n  @media (prefers-reduced-motion: reduce) {\\n    .rm-hero__topline,\\n    .rm-hero__glow {\\n      animation: none;\\n    }\\n  }\\n</style>\\n\\n<script>\\n  (function () {\\n    var root = document.currentScript.closest('.et_pb_section') || document.currentScript.parentElement;\\n    if (root) root.classList.add('rm-hero-section');\\n\\n    /* Particle canvas */\\n    var canvas = document.currentScript.parentElement.querySelector('.rm-hero__particles');\\n    if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\\n      var ctx = canvas.getContext('2d');\\n      var particles = [];\\n      var count = 46;\\n      var w, h;\\n\\n      function resize() {\\n        w = canvas.width = canvas.offsetWidth;\\n        h = canvas.height = canvas.offsetHeight;\\n      }\\n\\n      function init() {\\n        particles = [];\\n        for (var i = 0; i < count; i++) {\\n          particles.push({\\n            x: Math.random() * w,\\n            y: Math.random() * h,\\n            vx: (Math.random() - 0.5) * 0.25,\\n            vy: (Math.random() - 0.5) * 0.25\\n          });\\n        }\\n      }\\n\\n      function step() {\\n        ctx.clearRect(0, 0, w, h);\\n        for (var i = 0; i < particles.length; i++) {\\n          var p = particles[i];\\n          p.x += p.vx;\\n          p.y += p.vy;\\n          if (p.x < 0 || p.x > w) p.vx *= -1;\\n          if (p.y < 0 || p.y > h) p.vy *= -1;\\n        }\\n        for (var i = 0; i < particles.length; i++) {\\n          for (var j = i + 1; j < particles.length; j++) {\\n            var a = particles[i], b = particles[j];\\n            var dx = a.x - b.x, dy = a.y - b.y;\\n            var dist = Math.sqrt(dx * dx + dy * dy);\\n            if (dist < 140) {\\n              ctx.strokeStyle = 'rgba(58,123,213,' + (0.16 * (1 - dist / 140)) + ')';\\n              ctx.lineWidth = 1;\\n              ctx.beginPath();\\n              ctx.moveTo(a.x, a.y);\\n              ctx.lineTo(b.x, b.y);\\n              ctx.stroke();\\n            }\\n          }\\n        }\\n        for (var i = 0; i < particles.length; i++) {\\n          ctx.fillStyle = 'rgba(125,211,252,0.55)';\\n          ctx.beginPath();\\n          ctx.arc(particles[i].x, particles[i].y, 1.4, 0, Math.PI * 2);\\n          ctx.fill();\\n        }\\n        requestAnimationFrame(step);\\n      }\\n\\n      resize();\\n      init();\\n      step();\\n      window.addEventListener('resize', function () {\\n        resize();\\n        init();\\n      });\\n    }\\n\\n    /* Hub panel rotation */\\n    var panel = document.currentScript.parentElement.querySelector('.rm-hero__panel');\\n    if (panel) {\\n      var nodes = panel.querySelectorAll('.rm-hero__hub-node');\\n      var lines = panel.querySelectorAll('.rm-hero__hub-line');\\n      var captionTitle = panel.querySelector('.rm-hero__hub-caption-title');\\n      var captionText = panel.querySelector('.rm-hero__hub-caption-text');\\n      var data = [\\n        ['Dominio', 'Tu .es o .com, gestionado por nosotros.'],\\n        ['Web', 'Diseño profesional, listo para vender.'],\\n        ['Tienda online', 'Catálogo y cobros, sin plugins sueltos.'],\\n        ['Hosting', 'Alojamiento gestionado, sin líos técnicos.'],\\n        ['Marketing', 'Visibilidad y campañas que dan resultado.'],\\n        ['Correo', 'Tu propio @tuempresa.es, sin marcas ajenas.']\\n      ];\\n      var active = 0;\\n      var timer = null;\\n\\n      function setActive(i) {\\n        active = i;\\n        nodes.forEach(function (n) { n.classList.toggle('is-active', Number(n.dataset.i) === i); });\\n        lines.forEach(function (l) { l.classList.toggle('is-active', Number(l.dataset.i) === i); });\\n        if (captionTitle) captionTitle.textContent = data[i][0];\\n        if (captionText) captionText.textContent = data[i][1];\\n      }\\n\\n      function rotate() {\\n        setActive((active + 1) % nodes.length);\\n      }\\n\\n      setActive(0);\\n\\n      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\\n      if (!reduceMotion) {\\n        timer = setInterval(rotate, 2600);\\n      }\\n\\n      nodes.forEach(function (n) {\\n        n.addEventListener('click', function () {\\n          if (timer) { clearInterval(timer); timer = null; }\\n          setActive(Number(n.dataset.i));\\n        });\\n        n.addEventListener('mouseenter', function () {\\n          setActive(Number(n.dataset.i));\\n        });\\n      });\\n    }\\n  })();\\n</script>\\n\"}}},\"builderVersion\":\"5.11.1\"} /--><!-- /wp:divi/column --><!-- /wp:divi/row --><!-- /wp:divi/section --><!-- /wp:divi/placeholder -->"
