{"context":"et_builder","data":{"202":"<!-- wp:divi/placeholder --><!-- wp:divi/section {\"module\":{\"decoration\":{\"background\":{\"desktop\":{\"value\":{\"color\":\"$variable({\\u0022type\\u0022:\\u0022color\\u0022,\\u0022value\\u0022:{\\u0022name\\u0022:\\u0022gcid-primary-color\\u0022,\\u0022settings\\u0022:{}}})$\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/row {\"module\":{\"advanced\":{\"columnStructure\":{\"desktop\":{\"value\":\"4_4\"}},\"flexColumnStructure\":{\"desktop\":{\"value\":\"equal-columns_1\"}}},\"decoration\":{\"layout\":{\"desktop\":{\"value\":{\"flexWrap\":\"nowrap\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/column {\"module\":{\"advanced\":{\"type\":{\"desktop\":{\"value\":\"4_4\"}}},\"decoration\":{\"sizing\":{\"desktop\":{\"value\":{\"flexType\":\"24_24\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/code {\"content\":{\"innerContent\":{\"desktop\":{\"value\":\"\\u003cstyle\\u003e\\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700\\u0026family=Montserrat:wght@300;400;500\\u0026display=swap');\\n/* \u2500\u2500 Secci\u00f3n de Divi a ancho completo, sin paddings heredados \u2500\u2500 */\\n.et_pb_section:has(.ac-bl-page) { padding: 0 !important; background-color: #F5F2ED !important; }\\n.et_pb_section:has(.ac-bl-page) .et_pb_row { width: 100% !important; max-width: none !important; padding: 0 !important; }\\n.et_pb_section:has(.ac-bl-page) .et_pb_column { margin: 0 !important; }\\n.ac-bl-page p:empty, .ac-bl-page \\u003e br { display: none !important; }\\n/* \u2500\u2500 Variables de marca (escopadas) \u2500\u2500 */\\n.ac-bl-page {\\n  \\u002d\\u002dac-bl-lino:   #F5F2ED;\\n  \\u002d\\u002dac-bl-dark:   #2C2C2B;\\n  \\u002d\\u002dac-bl-arena:  #E5DED1;\\n  \\u002d\\u002dac-bl-verde:  #4B5332;\\n  \\u002d\\u002dac-bl-marron: #8C7B6A;\\n  \\u002d\\u002dac-bl-white:  #FFFFFF;\\n  \\u002d\\u002dac-bl-radius: 6px;\\n  \\u002d\\u002dac-bl-trans:  0.38s ease;\\n  background: var(\\u002d\\u002dac-bl-lino);\\n  color: var(\\u002d\\u002dac-bl-dark);\\n  min-height: 60vh;\\n  font-family: 'Montserrat', sans-serif;\\n  font-weight: 300;\\n  -webkit-font-smoothing: antialiased;\\n}\\n.ac-bl-page *, .ac-bl-page *::before, .ac-bl-page *::after { box-sizing: border-box; }\\n/* \u2500\u2500 Cabecera \u2500\u2500 */\\n.ac-bl-header {\\n  text-align: center;\\n  padding: 96px 24px 72px;\\n  border-bottom: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  position: relative;\\n  overflow: hidden;\\n  isolation: isolate;\\n}\\n/* Manchas bot\u00e1nicas difusas */\\n.ac-bl-header::before,\\n.ac-bl-header::after {\\n  content: '';\\n  position: absolute;\\n  border-radius: 50%;\\n  filter: blur(70px);\\n  z-index: -1;\\n  pointer-events: none;\\n}\\n.ac-bl-header::before {\\n  width: 420px; height: 420px;\\n  top: -180px; left: -120px;\\n  background: rgba(75, 83, 50, 0.14);\\n  animation: ac-bl-drift 18s ease-in-out infinite alternate;\\n}\\n.ac-bl-header::after {\\n  width: 360px; height: 360px;\\n  bottom: -200px; right: -100px;\\n  background: rgba(140, 123, 106, 0.18);\\n  animation: ac-bl-drift 22s ease-in-out infinite alternate-reverse;\\n}\\n@keyframes ac-bl-drift {\\n  from { transform: translate(0, 0) scale(1); }\\n  to   { transform: translate(40px, 30px) scale(1.12); }\\n}\\n.ac-bl-eyebrow {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 12px;\\n  font-weight: 500;\\n  font-size: 0.7rem;\\n  letter-spacing: 0.24em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  margin-bottom: 18px;\\n}\\n.ac-bl-eyebrow::before,\\n.ac-bl-eyebrow::after {\\n  content: '';\\n  width: 24px;\\n  height: 1px;\\n  background: var(\\u002d\\u002dac-bl-marron);\\n  opacity: 0.6;\\n}\\n.ac-bl-header h1 {\\n  font-family: 'Playfair Display', serif;\\n  font-weight: 700;\\n  font-style: normal;\\n  font-size: clamp(2.4rem, 5vw, 3.6rem);\\n  color: var(\\u002d\\u002dac-bl-dark);\\n  line-height: 1.12;\\n  margin: 0 0 20px;\\n  padding: 0;\\n}\\n.ac-bl-header h1 em {\\n  font-style: normal;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n}\\n.ac-bl-header-sub {\\n  font-weight: 300;\\n  font-size: 1rem;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  max-width: 460px;\\n  margin: 0 auto;\\n  padding: 0;\\n  line-height: 1.75;\\n}\\n.ac-bl-header-line {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 12px;\\n  margin-top: 36px;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  font-size: 0.9rem;\\n}\\n.ac-bl-header-line::before,\\n.ac-bl-header-line::after {\\n  content: '';\\n  width: 48px;\\n  height: 1px;\\n  background: var(\\u002d\\u002dac-bl-arena);\\n}\\n/* \u2500\u2500 Contenedor \u2500\u2500 */\\n.ac-bl-container {\\n  max-width: 1140px;\\n  margin: 0 auto;\\n  padding: 56px 32px 96px;\\n}\\n/* \u2500\u2500 Filtros por categor\u00eda \u2500\u2500 */\\n.ac-bl-filters {\\n  display: flex;\\n  flex-wrap: wrap;\\n  justify-content: center;\\n  gap: 10px;\\n  margin: 0 0 48px;\\n  padding: 0;\\n  list-style: none;\\n}\\n.ac-bl-filters[hidden] { display: none; }\\n.ac-bl-chip {\\n  font-family: 'Montserrat', sans-serif;\\n  font-weight: 500;\\n  font-size: 0.68rem;\\n  letter-spacing: 0.16em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  background: transparent;\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: 999px;\\n  padding: 10px 20px;\\n  cursor: pointer;\\n  transition: background var(\\u002d\\u002dac-bl-trans), color var(\\u002d\\u002dac-bl-trans), border-color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-chip:hover { border-color: var(\\u002d\\u002dac-bl-verde); }\\n.ac-bl-chip[aria-pressed=\\u0022true\\u0022] {\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  border-color: var(\\u002d\\u002dac-bl-verde);\\n  color: var(\\u002d\\u002dac-bl-lino);\\n}\\n.ac-bl-chip:focus-visible,\\n.ac-bl-page-btn:focus-visible,\\n.ac-bl-card a:focus-visible {\\n  outline: 2px solid var(\\u002d\\u002dac-bl-verde);\\n  outline-offset: 3px;\\n}\\n/* \u2500\u2500 Grid \u2500\u2500 */\\n.ac-bl-grid {\\n  display: grid;\\n  grid-template-columns: repeat(3, 1fr);\\n  gap: 32px;\\n}\\n/* \u2500\u2500 Card \u2500\u2500 */\\n.ac-bl-card {\\n  position: relative;\\n  background: var(\\u002d\\u002dac-bl-white);\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: var(\\u002d\\u002dac-bl-radius);\\n  overflow: hidden;\\n  display: flex;\\n  flex-direction: column;\\n  transition: box-shadow var(\\u002d\\u002dac-bl-trans), transform var(\\u002d\\u002dac-bl-trans), border-color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-card::before {\\n  content: '';\\n  position: absolute;\\n  top: 0; left: 0; right: 0;\\n  height: 3px;\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  transform: scaleX(0);\\n  transform-origin: left;\\n  transition: transform var(\\u002d\\u002dac-bl-trans);\\n  z-index: 2;\\n}\\n.ac-bl-card:hover {\\n  box-shadow: 0 16px 40px rgba(44, 44, 43, 0.10);\\n  transform: translateY(-6px);\\n  border-color: transparent;\\n}\\n.ac-bl-card:hover::before { transform: scaleX(1); }\\n/* Revelado al hacer scroll (solo si el JS est\u00e1 activo) */\\n.ac-bl-js .ac-bl-reveal {\\n  opacity: 0;\\n  translate: 0 24px;\\n  transition: opacity 0.6s ease, translate 0.6s ease;\\n}\\n.ac-bl-js .ac-bl-reveal.ac-bl-visible {\\n  opacity: 1;\\n  translate: 0 0;\\n}\\n/* \u2500\u2500 Imagen \u2500\u2500 */\\n.ac-bl-card-img {\\n  display: block;\\n  overflow: hidden;\\n  aspect-ratio: 16 / 10;\\n  background: var(\\u002d\\u002dac-bl-arena);\\n  flex-shrink: 0;\\n}\\n.ac-bl-card-img img {\\n  width: 100%;\\n  height: 100%;\\n  object-fit: cover;\\n  display: block;\\n  transition: transform 0.7s ease;\\n}\\n.ac-bl-card:hover .ac-bl-card-img img { transform: scale(1.05); }\\n.ac-bl-card-img-placeholder {\\n  width: 100%;\\n  height: 100%;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n}\\n.ac-bl-card-img-placeholder svg { width: 48px; height: 48px; opacity: 0.35; }\\n/* \u2500\u2500 Cuerpo \u2500\u2500 */\\n.ac-bl-card-body {\\n  padding: 26px 26px 28px;\\n  display: flex;\\n  flex-direction: column;\\n  flex: 1;\\n}\\n.ac-bl-card-cat {\\n  position: relative;\\n  z-index: 3;\\n  align-self: flex-start;\\n  font-weight: 500;\\n  font-size: 0.65rem;\\n  letter-spacing: 0.2em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  text-decoration: none;\\n  margin-bottom: 12px;\\n  transition: color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-card-cat:hover { color: var(\\u002d\\u002dac-bl-dark); }\\n.ac-bl-card-title {\\n  font-family: 'Playfair Display', serif;\\n  font-weight: 700;\\n  font-style: normal;\\n  font-size: 1.25rem;\\n  line-height: 1.3;\\n  color: var(\\u002d\\u002dac-bl-dark);\\n  margin: 0 0 14px;\\n  padding: 0;\\n}\\n.ac-bl-card-title a {\\n  color: inherit;\\n  text-decoration: none;\\n  transition: color var(\\u002d\\u002dac-bl-trans);\\n}\\n/* Toda la tarjeta clicable */\\n.ac-bl-card-title a::after {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  z-index: 1;\\n}\\n.ac-bl-card:hover .ac-bl-card-title a { color: var(\\u002d\\u002dac-bl-verde); }\\n.ac-bl-card-sep {\\n  width: 28px;\\n  height: 1px;\\n  background: var(\\u002d\\u002dac-bl-arena);\\n  margin-bottom: 14px;\\n  flex-shrink: 0;\\n}\\n.ac-bl-card-excerpt {\\n  font-weight: 300;\\n  font-size: 0.88rem;\\n  line-height: 1.78;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  margin: 0 0 24px;\\n  padding: 0;\\n  display: -webkit-box;\\n  -webkit-line-clamp: 4;\\n  -webkit-box-orient: vertical;\\n  overflow: hidden;\\n}\\n.ac-bl-card-cta {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-weight: 500;\\n  font-size: 0.68rem;\\n  letter-spacing: 0.18em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  margin-top: auto;\\n  padding-top: 20px;\\n  border-top: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  transition: gap var(\\u002d\\u002dac-bl-trans), color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-card-cta .ac-bl-arrow { transition: transform var(\\u002d\\u002dac-bl-trans); }\\n.ac-bl-card:hover .ac-bl-card-cta { color: var(\\u002d\\u002dac-bl-dark); gap: 12px; }\\n.ac-bl-card:hover .ac-bl-card-cta .ac-bl-arrow { transform: translateX(4px); }\\n/* \u2500\u2500 Art\u00edculo destacado (primero de la p\u00e1gina 1) \u2500\u2500 */\\n.ac-bl-card\\u002d\\u002dfeatured {\\n  grid-column: 1 / -1;\\n  display: grid;\\n  grid-template-columns: 1.25fr 1fr;\\n}\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-img { aspect-ratio: auto; min-height: 380px; height: 100%; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-body { padding: 48px 44px; justify-content: center; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-title { font-size: clamp(1.6rem, 2.6vw, 2.1rem); line-height: 1.22; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-excerpt { font-size: 0.95rem; -webkit-line-clamp: 5; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-cta { margin-top: 28px; }\\n.ac-bl-badge {\\n  display: inline-block;\\n  align-self: flex-start;\\n  font-weight: 500;\\n  font-size: 0.62rem;\\n  letter-spacing: 0.2em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-lino);\\n  background: var(\\u002d\\u002dac-bl-marron);\\n  border-radius: 999px;\\n  padding: 5px 12px;\\n  margin-bottom: 16px;\\n}\\n/* \u2500\u2500 Skeleton de carga \u2500\u2500 */\\n.ac-bl-skeleton {\\n  background: var(\\u002d\\u002dac-bl-white);\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: var(\\u002d\\u002dac-bl-radius);\\n  overflow: hidden;\\n}\\n.ac-bl-skel-img { aspect-ratio: 16 / 10; }\\n.ac-bl-skel-line { height: 12px; margin: 0 26px 12px; border-radius: 4px; }\\n.ac-bl-skel-line:first-of-type { margin-top: 26px; width: 30%; }\\n.ac-bl-skel-line.ac-bl-w80 { width: calc(80% - 52px); height: 18px; }\\n.ac-bl-skel-line.ac-bl-w60 { width: calc(60% - 52px); margin-bottom: 28px; }\\n.ac-bl-skel-img,\\n.ac-bl-skel-line {\\n  background: linear-gradient(90deg, var(\\u002d\\u002dac-bl-arena) 0%, #EFEAE1 50%, var(\\u002d\\u002dac-bl-arena) 100%);\\n  background-size: 200% 100%;\\n  animation: ac-bl-shimmer 1.4s ease-in-out infinite;\\n}\\n@keyframes ac-bl-shimmer {\\n  from { background-position: 100% 0; }\\n  to   { background-position: -100% 0; }\\n}\\n/* \u2500\u2500 Estados vac\u00edo / error \u2500\u2500 */\\n.ac-bl-empty {\\n  grid-column: 1 / -1;\\n  text-align: center;\\n  padding: 72px 24px;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n}\\n.ac-bl-empty p { font-weight: 300; font-size: 0.95rem; line-height: 1.75; margin: 0 0 20px; }\\n/* \u2500\u2500 Paginaci\u00f3n \u2500\u2500 */\\n.ac-bl-pagination {\\n  display: flex;\\n  justify-content: center;\\n  align-items: center;\\n  gap: 8px;\\n  margin-top: 64px;\\n  padding-top: 48px;\\n  border-top: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  flex-wrap: wrap;\\n}\\n.ac-bl-pagination[hidden] { display: none; }\\n.ac-bl-page-btn {\\n  font-family: 'Montserrat', sans-serif;\\n  font-weight: 500;\\n  font-size: 0.7rem;\\n  letter-spacing: 0.15em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  background: transparent;\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: 999px;\\n  min-width: 42px;\\n  padding: 11px 18px;\\n  cursor: pointer;\\n  transition: background var(\\u002d\\u002dac-bl-trans), color var(\\u002d\\u002dac-bl-trans), border-color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-page-btn:hover,\\n.ac-bl-page-btn[aria-current=\\u0022page\\u0022] {\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  color: var(\\u002d\\u002dac-bl-lino);\\n  border-color: var(\\u002d\\u002dac-bl-verde);\\n}\\n.ac-bl-page-btn:disabled { opacity: 0.35; cursor: default; pointer-events: none; }\\n.ac-bl-page-dots { color: var(\\u002d\\u002dac-bl-marron); padding: 0 4px; }\\n.ac-bl-sr {\\n  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\\n  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;\\n}\\n/* \u2500\u2500 Responsive \u2500\u2500 */\\n@media (max-width: 980px) {\\n  .ac-bl-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }\\n  .ac-bl-card\\u002d\\u002dfeatured { grid-template-columns: 1fr; }\\n  .ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-img { min-height: 0; aspect-ratio: 16 / 9; }\\n  .ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-body { padding: 32px 28px; }\\n}\\n@media (max-width: 640px) {\\n  .ac-bl-grid { grid-template-columns: 1fr; }\\n  .ac-bl-container { padding: 40px 18px 72px; }\\n  .ac-bl-header { padding: 64px 20px 48px; }\\n  .ac-bl-filters { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 0 -18px 36px; padding: 0 18px 6px; scrollbar-width: none; }\\n  .ac-bl-filters::-webkit-scrollbar { display: none; }\\n  .ac-bl-chip { flex-shrink: 0; }\\n  .ac-bl-card-body { padding: 22px 20px 24px; }\\n  .ac-bl-card-title { font-size: 1.15rem; }\\n  .ac-bl-page-btn.ac-bl-txt { padding: 11px 14px; }\\n}\\n@media (prefers-reduced-motion: reduce) {\\n  .ac-bl-page *, .ac-bl-page *::before, .ac-bl-page *::after { animation: none !important; transition: none !important; }\\n  .ac-bl-js .ac-bl-reveal { opacity: 1; translate: 0 0; }\\n}\\n/* \u2500\u2500 Extras de la plantilla de archivo \u2500\u2500 */\\n.ac-bl-crumbs {\\n  display: flex;\\n  justify-content: center;\\n  flex-wrap: wrap;\\n  gap: 8px;\\n  margin: 0 0 22px;\\n  padding: 0;\\n  list-style: none !important;\\n  font-size: 0.72rem;\\n  letter-spacing: 0.08em;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n}\\n.ac-bl-crumbs li { margin: 0; padding: 0; }\\n.ac-bl-crumbs li::marker { content: none; }\\n.ac-bl-crumbs li + li::before { content: '\u203a'; margin-right: 8px; opacity: 0.6; }\\n.ac-bl-crumbs a { color: var(\\u002d\\u002dac-bl-verde); text-decoration: none; }\\n.ac-bl-crumbs a:hover { text-decoration: underline; }\\n.ac-bl-count {\\n  display: block;\\n  margin-top: 14px;\\n  font-weight: 500;\\n  font-size: 0.7rem;\\n  letter-spacing: 0.18em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n}\\n.ac-bl-search {\\n  display: flex;\\n  max-width: 460px;\\n  margin: 32px auto 0;\\n  background: var(\\u002d\\u002dac-bl-white);\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: 999px;\\n  padding: 5px;\\n  transition: border-color var(\\u002d\\u002dac-bl-trans), box-shadow var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-search:focus-within { border-color: var(\\u002d\\u002dac-bl-verde); box-shadow: 0 6px 20px rgba(75, 83, 50, 0.10); }\\n.ac-bl-search input[type=\\u0022search\\u0022] {\\n  flex: 1;\\n  min-width: 0;\\n  border: 0 !important;\\n  background: transparent !important;\\n  box-shadow: none !important;\\n  padding: 10px 18px !important;\\n  font-family: 'Montserrat', sans-serif;\\n  font-size: 0.9rem;\\n  font-weight: 300;\\n  color: var(\\u002d\\u002dac-bl-dark);\\n  outline: none;\\n}\\n.ac-bl-search button {\\n  border: 0;\\n  border-radius: 999px;\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  color: var(\\u002d\\u002dac-bl-lino);\\n  font-family: 'Montserrat', sans-serif;\\n  font-weight: 500;\\n  font-size: 0.68rem;\\n  letter-spacing: 0.15em;\\n  text-transform: uppercase;\\n  padding: 0 22px;\\n  cursor: pointer;\\n  transition: background var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-search button:hover { background: var(\\u002d\\u002dac-bl-dark); }\\na.ac-bl-chip { text-decoration: none; display: inline-block; }\\na.ac-bl-chip[aria-current=\\u0022page\\u0022] {\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  border-color: var(\\u002d\\u002dac-bl-verde);\\n  color: var(\\u002d\\u002dac-bl-lino);\\n}\\n.ac-bl-empty .ac-bl-page-btn { text-decoration: none; display: inline-block; }\\nmark.ac-bl-hl { background: rgba(75, 83, 50, 0.14); color: inherit; padding: 0 2px; border-radius: 2px; }\\n\\u003c/style\\u003e\\n\\n\\u003cdiv class=\\u0022ac-bl-page ac-bl-archive\\u0022 id=\\u0022ac-ar-page\\u0022\\u003e\\n  \\u003cheader class=\\u0022ac-bl-header\\u0022\\u003e\\n    \\u003col class=\\u0022ac-bl-crumbs\\u0022 id=\\u0022ac-ar-crumbs\\u0022\\u003e\\n      \\u003cli\\u003e\\u003ca href=\\u0022/\\u0022\\u003eInicio\\u003c/a\\u003e\\u003c/li\\u003e\\n      \\u003cli\\u003e\\u003ca href=\\u0022/blog/\\u0022 id=\\u0022ac-ar-blog-link\\u0022\\u003eBlog\\u003c/a\\u003e\\u003c/li\\u003e\\n    \\u003c/ol\\u003e\\n    \\u003cspan class=\\u0022ac-bl-eyebrow\\u0022 id=\\u0022ac-ar-eyebrow\\u0022\\u003eArchivo del blog\\u003c/span\\u003e\\n    \\u003ch1 id=\\u0022ac-ar-title\\u0022\\u003eArt\u00edculos\\u003c/h1\\u003e\\n    \\u003cp class=\\u0022ac-bl-header-sub\\u0022 id=\\u0022ac-ar-sub\\u0022\\u003eArt\u00edculos honestos sobre plantas, mezclas y el arte de cuidar tu cabello a tu ritmo.\\u003c/p\\u003e\\n    \\u003cspan class=\\u0022ac-bl-count\\u0022 id=\\u0022ac-ar-count\\u0022\\u003e\\u003c/span\\u003e\\n    \\u003cform class=\\u0022ac-bl-search\\u0022 role=\\u0022search\\u0022 method=\\u0022get\\u0022 action=\\u0022/\\u0022\\u003e\\n      \\u003clabel class=\\u0022ac-bl-sr\\u0022 for=\\u0022ac-ar-s\\u0022\\u003eBuscar en el blog\\u003c/label\\u003e\\n      \\u003cinput type=\\u0022search\\u0022 id=\\u0022ac-ar-s\\u0022 name=\\u0022s\\u0022 placeholder=\\u0022Buscar: henna, canas, \u00edndigo\u2026\\u0022\\u003e\\n      \\u003cinput type=\\u0022hidden\\u0022 name=\\u0022post_type\\u0022 value=\\u0022post\\u0022\\u003e\\n      \\u003cbutton type=\\u0022submit\\u0022\\u003eBuscar\\u003c/button\\u003e\\n    \\u003c/form\\u003e\\n  \\u003c/header\\u003e\\n  \\u003cdiv class=\\u0022ac-bl-container\\u0022\\u003e\\n    \\u003cnav aria-label=\\u0022Categor\u00edas del blog\\u0022\\u003e\\n      \\u003cdiv id=\\u0022ac-ar-filters\\u0022 class=\\u0022ac-bl-filters\\u0022 hidden\\u003e\\u003c/div\\u003e\\n    \\u003c/nav\\u003e\\n    \\u003cp id=\\u0022ac-ar-status\\u0022 class=\\u0022ac-bl-sr\\u0022 aria-live=\\u0022polite\\u0022\\u003e\\u003c/p\\u003e\\n    \\u003cdiv id=\\u0022ac-ar-grid\\u0022 class=\\u0022ac-bl-grid\\u0022 aria-busy=\\u0022true\\u0022\\u003e\\u003c/div\\u003e\\n    \\u003cnav id=\\u0022ac-ar-pagination\\u0022 class=\\u0022ac-bl-pagination\\u0022 aria-label=\\u0022Paginaci\u00f3n\\u0022 hidden\\u003e\\u003c/nav\\u003e\\n  \\u003c/div\\u003e\\n\\u003c/div\\u003e\\n\\n\\u003cscript\\u003e\\n(function () {\\n  /* \u2500\u2500 Configuraci\u00f3n \u2500\u2500 */\\n  var BLOG_URL    = '/blog/';   /* Direcci\u00f3n de la p\u00e1gina del blog */\\n  var PER_PAGE    = 9;\\n  var EXCERPT_LEN = 160;\\n  var API = window.location.origin + '/wp-json/wp/v2/';\\n  /* \u2500\u2500 DOM \u2500\u2500 */\\n  var root = document.getElementById('ac-ar-page');\\n  if (!root) { return; }\\n  var grid       = document.getElementById('ac-ar-grid');\\n  var pagination = document.getElementById('ac-ar-pagination');\\n  var filters    = document.getElementById('ac-ar-filters');\\n  var statusEl   = document.getElementById('ac-ar-status');\\n  var titleEl    = document.getElementById('ac-ar-title');\\n  var eyebrowEl  = document.getElementById('ac-ar-eyebrow');\\n  var subEl      = document.getElementById('ac-ar-sub');\\n  var countEl    = document.getElementById('ac-ar-count');\\n  var searchIn   = document.getElementById('ac-ar-s');\\n  document.getElementById('ac-ar-blog-link').setAttribute('href', BLOG_URL);\\n  var canReveal = 'IntersectionObserver' in window;\\n  if (canReveal) { root.classList.add('ac-bl-js'); }\\n  /* \u2500\u2500 Helpers \u2500\u2500 */\\n  function esc(str) {\\n    return String(str || '').replace(/[\\u0026\\u003c\\u003e\\u0022']/g, function (c) {\\n      return { '\\u0026': '\\u0026amp;', '\\u003c': '\\u0026lt;', '\\u003e': '\\u0026gt;', '\\u0022': '\\u0026quot;', \\u0022'\\u0022: '\\u0026#39;' }[c];\\n    });\\n  }\\n  function decode(html) {\\n    var t = document.createElement('textarea');\\n    t.innerHTML = html || '';\\n    return t.value;\\n  }\\n  function plain(html) {\\n    var t = document.createElement('div');\\n    t.innerHTML = html || '';\\n    return (t.textContent || '').replace(/\\\\[(\\u0026hellip;|\u2026)\\\\]/g, '').replace(/\\\\s+/g, ' ').trim();\\n  }\\n  function cut(text, max) {\\n    if (text.length \\u003e max) { return text.substring(0, max).replace(/\\\\s+\\\\S*$/, '') + '\u2026'; }\\n    return text;\\n  }\\n  function getJSON(url) {\\n    return fetch(url).then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); });\\n  }\\n  function bodyId(prefix) {\\n    var m = document.body.className.match(new RegExp('(?:^|\\\\\\\\s)' + prefix + '-(\\\\\\\\d+)(?:\\\\\\\\s|$)'));\\n    return m ? parseInt(m[1], 10) : 0;\\n  }\\n  /* \u2500\u2500 Contexto del archivo actual \u2500\u2500 */\\n  var params = new URLSearchParams(window.location.search);\\n  var ctx = { type: 'all', query: '', label: '' };\\n  var bc = document.body.classList;\\n  if (bc.contains('search')) {\\n    ctx.type = 'search';\\n    ctx.term = (params.get('s') || '').trim();\\n    ctx.query = '\\u0026search=' + encodeURIComponent(ctx.term);\\n  } else if (bc.contains('category')) {\\n    ctx.type = 'category';\\n    ctx.id = bodyId('category');\\n    ctx.query = '\\u0026categories=' + ctx.id;\\n  } else if (bc.contains('tag')) {\\n    ctx.type = 'tag';\\n    ctx.id = bodyId('tag');\\n    ctx.query = '\\u0026tags=' + ctx.id;\\n  } else if (bc.contains('author')) {\\n    ctx.type = 'author';\\n    ctx.id = bodyId('author');\\n    ctx.query = '\\u0026author=' + ctx.id;\\n  } else if (bc.contains('date')) {\\n    ctx.type = 'date';\\n    var dm = window.location.pathname.match(/\\\\/(\\\\d{4})(?:\\\\/(\\\\d{2}))?/);\\n    if (dm) {\\n      var y = parseInt(dm[1], 10);\\n      var mo = dm[2] ? parseInt(dm[2], 10) : 0;\\n      var from = new Date(Date.UTC(y, mo ? mo - 1 : 0, 1));\\n      var to = mo ? new Date(Date.UTC(y, mo, 1)) : new Date(Date.UTC(y + 1, 0, 1));\\n      ctx.query = '\\u0026after=' + encodeURIComponent(new Date(from - 1).toISOString()) + '\\u0026before=' + encodeURIComponent(to.toISOString());\\n      ctx.dateLabel = mo ? from.toLocaleDateString('es-ES', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : String(y);\\n    }\\n  }\\n  /* \u2500\u2500 Cabecera din\u00e1mica \u2500\u2500 */\\n  function setHeader(eyebrow, title, sub) {\\n    eyebrowEl.textContent = eyebrow;\\n    titleEl.textContent = title;\\n    if (sub) { subEl.textContent = sub; } else { subEl.hidden = true; }\\n    var crumbs = document.getElementById('ac-ar-crumbs');\\n    var li = document.createElement('li');\\n    li.setAttribute('aria-current', 'page');\\n    li.textContent = title;\\n    crumbs.appendChild(li);\\n  }\\n  function headerReady() {\\n    if (ctx.type === 'search') {\\n      searchIn.value = ctx.term;\\n      setHeader('Resultados de b\u00fasqueda', ctx.term ? '\u00ab' + ctx.term + '\u00bb' : 'Buscar en el blog', '');\\n      return Promise.resolve();\\n    }\\n    if (ctx.type === 'date') {\\n      var lbl = ctx.dateLabel || 'Archivo';\\n      setHeader('Archivo', lbl.charAt(0).toUpperCase() + lbl.slice(1), '');\\n      return Promise.resolve();\\n    }\\n    var ep = { category: 'categories/', tag: 'tags/', author: 'users/' }[ctx.type];\\n    if (!ep) { return Promise.resolve(); }\\n    if (!ctx.id) { return Promise.resolve(); }\\n    return getJSON(API + ep + ctx.id).then(function (t) {\\n      var eyebrow = { category: 'Categor\u00eda', tag: 'Etiqueta', author: 'Art\u00edculos de' }[ctx.type];\\n      setHeader(eyebrow, decode(t.name), plain(t.description));\\n    }).catch(function () {\\n      var h = document.title.split(/\\\\s[|\u2013-]\\\\s/)[0];\\n      setHeader('Archivo del blog', h, '');\\n    });\\n  }\\n  /* \u2500\u2500 Tarjetas \u2500\u2500 */\\n  function highlight(text) {\\n    var safe = esc(text);\\n    if (ctx.type !== 'search') { return safe; }\\n    if (ctx.term.length \\u003c 3) { return safe; }\\n    var re = new RegExp('(' + esc(ctx.term).replace(/[.*+?^${}()|[\\\\]\\\\\\\\]/g, '\\\\\\\\$\\u0026') + ')', 'gi');\\n    return safe.replace(re, '\\u003cmark class=\\u0022ac-bl-hl\\u0022\\u003e$1\\u003c/mark\\u003e');\\n  }\\n  function media(post) {\\n    var e = post._embedded || {};\\n    var m = e['wp:featuredmedia'];\\n    if (!m) { return null; }\\n    if (!m[0]) { return null; }\\n    return m[0].source_url ? m[0] : null;\\n  }\\n  function firstCat(post) {\\n    var e = post._embedded || {};\\n    var t = e['wp:term'];\\n    if (!t) { return null; }\\n    if (!t[0]) { return null; }\\n    return t[0][0] || null;\\n  }\\n  function imgHTML(post, title) {\\n    var m = media(post);\\n    if (!m) {\\n      return '\\u003cdiv class=\\u0022ac-bl-card-img-placeholder\\u0022 aria-hidden=\\u0022true\\u0022\\u003e\\u003csvg viewBox=\\u00220 0 48 48\\u0022 fill=\\u0022none\\u0022 stroke=\\u0022currentColor\\u0022 stroke-width=\\u00221.5\\u0022\\u003e\\u003cpath d=\\u0022M10 38c18 0 28-12 28-28C20 10 10 22 10 38Z\\u0022 stroke-linejoin=\\u0022round\\u0022/\\u003e\\u003cpath d=\\u0022M10 38 26 22\\u0022 stroke-linecap=\\u0022round\\u0022/\\u003e\\u003c/svg\\u003e\\u003c/div\\u003e';\\n    }\\n    var sizes = (m.media_details || {}).sizes || {};\\n    var pick = sizes.medium_large || sizes.large;\\n    var srcset = [];\\n    ['medium', 'medium_large', 'large'].forEach(function (k) {\\n      if (sizes[k]) { srcset.push(sizes[k].source_url + ' ' + sizes[k].width + 'w'); }\\n    });\\n    return '\\u003cimg src=\\u0022' + esc(pick ? pick.source_url : m.source_url) + '\\u0022' +\\n      (srcset.length ? ' srcset=\\u0022' + esc(srcset.join(', ')) + '\\u0022 sizes=\\u0022(max-width: 640px) 100vw, (max-width: 980px) 50vw, 360px\\u0022' : '') +\\n      ' alt=\\u0022' + esc(m.alt_text || title) + '\\u0022 loading=\\u0022lazy\\u0022 decoding=\\u0022async\\u0022\\u003e';\\n  }\\n  function buildCard(post) {\\n    var title = decode(post.title.rendered);\\n    var excerpt = cut(plain(post.excerpt.rendered), EXCERPT_LEN);\\n    var cat = firstCat(post);\\n    var card = document.createElement('article');\\n    card.className = 'ac-bl-card ac-bl-reveal';\\n    card.innerHTML =\\n      '\\u003cdiv class=\\u0022ac-bl-card-img\\u0022\\u003e' + imgHTML(post, title) + '\\u003c/div\\u003e' +\\n      '\\u003cdiv class=\\u0022ac-bl-card-body\\u0022\\u003e' +\\n        (cat ? '\\u003ca class=\\u0022ac-bl-card-cat\\u0022 href=\\u0022' + esc(cat.link) + '\\u0022\\u003e' + esc(decode(cat.name)) + '\\u003c/a\\u003e' : '') +\\n        '\\u003ch2 class=\\u0022ac-bl-card-title\\u0022\\u003e\\u003ca href=\\u0022' + esc(post.link) + '\\u0022\\u003e' + highlight(title) + '\\u003c/a\\u003e\\u003c/h2\\u003e' +\\n        '\\u003cdiv class=\\u0022ac-bl-card-sep\\u0022\\u003e\\u003c/div\\u003e' +\\n        (excerpt ? '\\u003cp class=\\u0022ac-bl-card-excerpt\\u0022\\u003e' + highlight(excerpt) + '\\u003c/p\\u003e' : '') +\\n        '\\u003cspan class=\\u0022ac-bl-card-cta\\u0022 aria-hidden=\\u0022true\\u0022\\u003eLeer art\u00edculo \\u003cspan class=\\u0022ac-bl-arrow\\u0022\\u003e\u2192\\u003c/span\\u003e\\u003c/span\\u003e' +\\n      '\\u003c/div\\u003e';\\n    return card;\\n  }\\n  var observer = null;\\n  if (canReveal) {\\n    observer = new IntersectionObserver(function (entries) {\\n      entries.forEach(function (entry) {\\n        if (entry.isIntersecting) {\\n          var el = entry.target;\\n          el.classList.add('ac-bl-visible');\\n          observer.unobserve(el);\\n          setTimeout(function () { el.style.transitionDelay = ''; }, 900);\\n        }\\n      });\\n    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });\\n  }\\n  /* \u2500\u2500 Categor\u00edas como enlaces (enlazado interno) \u2500\u2500 */\\n  getJSON(API + 'categories?per_page=50\\u0026hide_empty=true\\u0026orderby=count\\u0026order=desc\\u0026_fields=id,name,link,count')\\n    .then(function (list) {\\n      if (list.length \\u003c 2) { return; }\\n      var html = '\\u003ca class=\\u0022ac-bl-chip\\u0022 href=\\u0022' + esc(BLOG_URL) + '\\u0022\\u003eTodos\\u003c/a\\u003e';\\n      list.forEach(function (c) {\\n        var current = ctx.type === 'category' ? c.id === ctx.id : false;\\n        html += '\\u003ca class=\\u0022ac-bl-chip\\u0022 href=\\u0022' + esc(c.link) + '\\u0022' + (current ? ' aria-current=\\u0022page\\u0022' : '') + '\\u003e' + esc(decode(c.name)) + '\\u003c/a\\u003e';\\n      });\\n      filters.innerHTML = html;\\n      filters.hidden = false;\\n    })\\n    .catch(function () {});\\n  /* \u2500\u2500 Listado y paginaci\u00f3n \u2500\u2500 */\\n  var wpPage = window.location.pathname.match(/\\\\/page\\\\/(\\\\d+)\\\\/?$/);\\n  var state = { page: Math.max(1, parseInt(params.get('pagina'), 10) || (wpPage ? parseInt(wpPage[1], 10) : 1)), total: 1, first: true, req: 0 };\\n  function skeleton() {\\n    var html = '';\\n    for (var i = 0; i \\u003c 6; i++) {\\n      html += '\\u003cdiv class=\\u0022ac-bl-skeleton\\u0022 aria-hidden=\\u0022true\\u0022\\u003e\\u003cdiv class=\\u0022ac-bl-skel-img\\u0022\\u003e\\u003c/div\\u003e\\u003cdiv class=\\u0022ac-bl-skel-line\\u0022\\u003e\\u003c/div\\u003e\\u003cdiv class=\\u0022ac-bl-skel-line ac-bl-w80\\u0022\\u003e\\u003c/div\\u003e\\u003cdiv class=\\u0022ac-bl-skel-line ac-bl-w60\\u0022\\u003e\\u003c/div\\u003e\\u003c/div\\u003e';\\n    }\\n    grid.innerHTML = html;\\n    grid.setAttribute('aria-busy', 'true');\\n  }\\n  function empty(msg) {\\n    grid.innerHTML = '\\u003cdiv class=\\u0022ac-bl-empty\\u0022\\u003e\\u003cp\\u003e' + msg + '\\u003c/p\\u003e\\u003ca class=\\u0022ac-bl-page-btn\\u0022 href=\\u0022' + esc(BLOG_URL) + '\\u0022\\u003eVer todos los art\u00edculos\\u003c/a\\u003e\\u003c/div\\u003e';\\n  }\\n  function pageBtn(label, page, opts) {\\n    var b = document.createElement('button');\\n    b.type = 'button';\\n    b.className = 'ac-bl-page-btn' + (opts.txt ? ' ac-bl-txt' : '');\\n    b.innerHTML = label;\\n    if (opts.aria) { b.setAttribute('aria-label', opts.aria); }\\n    if (opts.current) { b.setAttribute('aria-current', 'page'); }\\n    if (opts.disabled) { b.disabled = true; }\\n    b.addEventListener('click', function () { go(page); });\\n    return b;\\n  }\\n  function renderPagination() {\\n    pagination.innerHTML = '';\\n    if (state.total \\u003c= 1) { pagination.hidden = true; return; }\\n    pagination.hidden = false;\\n    var cur = state.page;\\n    pagination.appendChild(pageBtn('\u2190\\u003cspan class=\\u0022ac-bl-sr\\u0022\\u003e Anterior\\u003c/span\\u003e', cur - 1, { txt: true, aria: 'P\u00e1gina anterior', disabled: cur === 1 }));\\n    var last = 0;\\n    for (var p = 1; p \\u003c= state.total; p++) {\\n      if (p === 1 || p === state.total || Math.abs(p - cur) \\u003c= 1) {\\n        if (p - last \\u003e 1) {\\n          var d = document.createElement('span');\\n          d.className = 'ac-bl-page-dots';\\n          d.textContent = '\u2026';\\n          pagination.appendChild(d);\\n        }\\n        pagination.appendChild(pageBtn(String(p), p, { current: p === cur, aria: 'P\u00e1gina ' + p }));\\n        last = p;\\n      }\\n    }\\n    pagination.appendChild(pageBtn('\\u003cspan class=\\u0022ac-bl-sr\\u0022\\u003eSiguiente \\u003c/span\\u003e\u2192', cur + 1, { txt: true, aria: 'P\u00e1gina siguiente', disabled: cur === state.total }));\\n  }\\n  function go(page) {\\n    state.page = page;\\n    var q = new URLSearchParams(window.location.search);\\n    if (page \\u003e 1) { q.set('pagina', page); } else { q.delete('pagina'); }\\n    var qs = q.toString();\\n    history.pushState({}, '', window.location.pathname + (qs ? '?' + qs : ''));\\n    load();\\n  }\\n  window.addEventListener('popstate', function () {\\n    state.page = Math.max(1, parseInt(new URLSearchParams(window.location.search).get('pagina'), 10) || 1);\\n    load();\\n  });\\n  function load() {\\n    var id = ++state.req;\\n    if (state.first) {\\n      state.first = false;\\n    } else {\\n      var top = root.querySelector('.ac-bl-container').getBoundingClientRect().top + window.pageYOffset - 100;\\n      window.scrollTo({ top: top, behavior: 'smooth' });\\n    }\\n    if (ctx.type === 'search') {\\n      if (!ctx.term) {\\n        grid.setAttribute('aria-busy', 'false');\\n        empty('Escribe una palabra para buscar entre los art\u00edculos.');\\n        return;\\n      }\\n    }\\n    skeleton();\\n    pagination.hidden = true;\\n    var total = 0;\\n    fetch(API + 'posts?per_page=' + PER_PAGE + '\\u0026page=' + state.page + '\\u0026_embed=wp:featuredmedia,wp:term' + ctx.query)\\n      .then(function (r) {\\n        if (r.status === 400) { return []; }\\n        if (!r.ok) { throw new Error(r.status); }\\n        total = parseInt(r.headers.get('X-WP-Total') || '0', 10);\\n        state.total = parseInt(r.headers.get('X-WP-TotalPages') || '1', 10);\\n        return r.json();\\n      })\\n      .then(function (posts) {\\n        if (id !== state.req) { return; }\\n        grid.innerHTML = '';\\n        grid.setAttribute('aria-busy', 'false');\\n        countEl.textContent = total === 1 ? '1 art\u00edculo' : (total ? total + ' art\u00edculos' : '');\\n        if (!posts.length) {\\n          if (ctx.type === 'search') {\\n            empty('No hemos encontrado art\u00edculos para \u00ab' + esc(ctx.term) + '\u00bb.\\u003cbr\\u003ePrueba con otra palabra, como henna, canas o \u00edndigo.');\\n          } else {\\n            empty('Todav\u00eda no hay art\u00edculos en esta secci\u00f3n.\\u003cbr\\u003eVuelve pronto \u2014 la alquimia est\u00e1 en proceso.');\\n          }\\n          statusEl.textContent = 'Sin resultados.';\\n          return;\\n        }\\n        posts.forEach(function (post, i) {\\n          var card = buildCard(post);\\n          card.style.transitionDelay = ((i % 3) * 90) + 'ms';\\n          grid.appendChild(card);\\n          if (observer) { observer.observe(card); }\\n        });\\n        renderPagination();\\n        statusEl.textContent = total + ' art\u00edculos. P\u00e1gina ' + state.page + ' de ' + state.total + '.';\\n      })\\n      .catch(function () {\\n        if (id !== state.req) { return; }\\n        grid.setAttribute('aria-busy', 'false');\\n        empty('No se han podido cargar los art\u00edculos.\\u003cbr\\u003eInt\u00e9ntalo de nuevo en unos momentos.');\\n      });\\n  }\\n  headerReady();\\n  load();\\n})();\\n\\u003c/script\\u003e\\n\"}}},\"builderVersion\":\"5.5.0\"} /-->\r\n<!-- /wp:divi/column -->\r\n<!-- /wp:divi/row -->\r\n<!-- /wp:divi/section --><!-- /wp:divi/placeholder -->"},"presets":null,"global_colors":[["gcid-primary-color",{"color":"#f5f2ed","status":"active","label":"Color Primario"}]],"global_variables":[],"page_settings_meta":{"_et_pb_custom_css":[""]},"canvases":{"local":[],"global":[]},"images":[],"thumbnails":[]}