{"context":"et_builder","data":{"199":"<!-- wp:divi/placeholder --><!-- wp:divi/section {\"module\":{\"decoration\":{\"background\":{\"desktop\":{\"value\":{\"color\":\"$variable({\\u0022type\\u0022:\\u0022color\\u0022,\\u0022value\\u0022:{\\u0022name\\u0022:\\u0022gcid-primary-color\\u0022,\\u0022settings\\u0022:{}}})$\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/row {\"module\":{\"advanced\":{\"columnStructure\":{\"desktop\":{\"value\":\"4_4\"}},\"flexColumnStructure\":{\"desktop\":{\"value\":\"equal-columns_1\"}}},\"decoration\":{\"layout\":{\"desktop\":{\"value\":{\"flexWrap\":\"nowrap\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/column {\"module\":{\"advanced\":{\"type\":{\"desktop\":{\"value\":\"4_4\"}}},\"decoration\":{\"sizing\":{\"desktop\":{\"value\":{\"flexType\":\"24_24\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/code {\"content\":{\"innerContent\":{\"desktop\":{\"value\":\"\\u003cstyle\\u003e\\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700\\u0026family=Montserrat:wght@300;400;500\\u0026display=swap');\\n/* \u2500\u2500 Secci\u00f3n de Divi a ancho completo, sin paddings heredados \u2500\u2500 */\\n.et_pb_section:has(.ac-bl-page) { padding: 0 !important; background-color: #F5F2ED !important; }\\n.et_pb_section:has(.ac-bl-page) .et_pb_row { width: 100% !important; max-width: none !important; padding: 0 !important; }\\n.et_pb_section:has(.ac-bl-page) .et_pb_column { margin: 0 !important; }\\n.ac-bl-page p:empty, .ac-bl-page \\u003e br { display: none !important; }\\n/* \u2500\u2500 Variables de marca (escopadas) \u2500\u2500 */\\n.ac-bl-page {\\n  \\u002d\\u002dac-bl-lino:   #F5F2ED;\\n  \\u002d\\u002dac-bl-dark:   #2C2C2B;\\n  \\u002d\\u002dac-bl-arena:  #E5DED1;\\n  \\u002d\\u002dac-bl-verde:  #4B5332;\\n  \\u002d\\u002dac-bl-marron: #8C7B6A;\\n  \\u002d\\u002dac-bl-white:  #FFFFFF;\\n  \\u002d\\u002dac-bl-radius: 6px;\\n  \\u002d\\u002dac-bl-trans:  0.38s ease;\\n  background: var(\\u002d\\u002dac-bl-lino);\\n  color: var(\\u002d\\u002dac-bl-dark);\\n  min-height: 60vh;\\n  font-family: 'Montserrat', sans-serif;\\n  font-weight: 300;\\n  -webkit-font-smoothing: antialiased;\\n}\\n.ac-bl-page *, .ac-bl-page *::before, .ac-bl-page *::after { box-sizing: border-box; }\\n/* \u2500\u2500 Cabecera \u2500\u2500 */\\n.ac-bl-header {\\n  text-align: center;\\n  padding: 96px 24px 72px;\\n  border-bottom: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  position: relative;\\n  overflow: hidden;\\n  isolation: isolate;\\n}\\n/* Manchas bot\u00e1nicas difusas */\\n.ac-bl-header::before,\\n.ac-bl-header::after {\\n  content: '';\\n  position: absolute;\\n  border-radius: 50%;\\n  filter: blur(70px);\\n  z-index: -1;\\n  pointer-events: none;\\n}\\n.ac-bl-header::before {\\n  width: 420px; height: 420px;\\n  top: -180px; left: -120px;\\n  background: rgba(75, 83, 50, 0.14);\\n  animation: ac-bl-drift 18s ease-in-out infinite alternate;\\n}\\n.ac-bl-header::after {\\n  width: 360px; height: 360px;\\n  bottom: -200px; right: -100px;\\n  background: rgba(140, 123, 106, 0.18);\\n  animation: ac-bl-drift 22s ease-in-out infinite alternate-reverse;\\n}\\n@keyframes ac-bl-drift {\\n  from { transform: translate(0, 0) scale(1); }\\n  to   { transform: translate(40px, 30px) scale(1.12); }\\n}\\n.ac-bl-eyebrow {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 12px;\\n  font-weight: 500;\\n  font-size: 0.7rem;\\n  letter-spacing: 0.24em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  margin-bottom: 18px;\\n}\\n.ac-bl-eyebrow::before,\\n.ac-bl-eyebrow::after {\\n  content: '';\\n  width: 24px;\\n  height: 1px;\\n  background: var(\\u002d\\u002dac-bl-marron);\\n  opacity: 0.6;\\n}\\n.ac-bl-header h1 {\\n  font-family: 'Playfair Display', serif;\\n  font-weight: 700;\\n  font-style: normal;\\n  font-size: clamp(2.4rem, 5vw, 3.6rem);\\n  color: var(\\u002d\\u002dac-bl-dark);\\n  line-height: 1.12;\\n  margin: 0 0 20px;\\n  padding: 0;\\n}\\n.ac-bl-header h1 em {\\n  font-style: normal;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n}\\n.ac-bl-header-sub {\\n  font-weight: 300;\\n  font-size: 1rem;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  max-width: 460px;\\n  margin: 0 auto;\\n  padding: 0;\\n  line-height: 1.75;\\n}\\n.ac-bl-header-line {\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  gap: 12px;\\n  margin-top: 36px;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  font-size: 0.9rem;\\n}\\n.ac-bl-header-line::before,\\n.ac-bl-header-line::after {\\n  content: '';\\n  width: 48px;\\n  height: 1px;\\n  background: var(\\u002d\\u002dac-bl-arena);\\n}\\n/* \u2500\u2500 Contenedor \u2500\u2500 */\\n.ac-bl-container {\\n  max-width: 1140px;\\n  margin: 0 auto;\\n  padding: 56px 32px 96px;\\n}\\n/* \u2500\u2500 Filtros por categor\u00eda \u2500\u2500 */\\n.ac-bl-filters {\\n  display: flex;\\n  flex-wrap: wrap;\\n  justify-content: center;\\n  gap: 10px;\\n  margin: 0 0 48px;\\n  padding: 0;\\n  list-style: none;\\n}\\n.ac-bl-filters[hidden] { display: none; }\\n.ac-bl-chip {\\n  font-family: 'Montserrat', sans-serif;\\n  font-weight: 500;\\n  font-size: 0.68rem;\\n  letter-spacing: 0.16em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  background: transparent;\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: 999px;\\n  padding: 10px 20px;\\n  cursor: pointer;\\n  transition: background var(\\u002d\\u002dac-bl-trans), color var(\\u002d\\u002dac-bl-trans), border-color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-chip:hover { border-color: var(\\u002d\\u002dac-bl-verde); }\\n.ac-bl-chip[aria-pressed=\\u0022true\\u0022] {\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  border-color: var(\\u002d\\u002dac-bl-verde);\\n  color: var(\\u002d\\u002dac-bl-lino);\\n}\\n.ac-bl-chip:focus-visible,\\n.ac-bl-page-btn:focus-visible,\\n.ac-bl-card a:focus-visible {\\n  outline: 2px solid var(\\u002d\\u002dac-bl-verde);\\n  outline-offset: 3px;\\n}\\n/* \u2500\u2500 Grid \u2500\u2500 */\\n.ac-bl-grid {\\n  display: grid;\\n  grid-template-columns: repeat(3, 1fr);\\n  gap: 32px;\\n}\\n/* \u2500\u2500 Card \u2500\u2500 */\\n.ac-bl-card {\\n  position: relative;\\n  background: var(\\u002d\\u002dac-bl-white);\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: var(\\u002d\\u002dac-bl-radius);\\n  overflow: hidden;\\n  display: flex;\\n  flex-direction: column;\\n  transition: box-shadow var(\\u002d\\u002dac-bl-trans), transform var(\\u002d\\u002dac-bl-trans), border-color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-card::before {\\n  content: '';\\n  position: absolute;\\n  top: 0; left: 0; right: 0;\\n  height: 3px;\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  transform: scaleX(0);\\n  transform-origin: left;\\n  transition: transform var(\\u002d\\u002dac-bl-trans);\\n  z-index: 2;\\n}\\n.ac-bl-card:hover {\\n  box-shadow: 0 16px 40px rgba(44, 44, 43, 0.10);\\n  transform: translateY(-6px);\\n  border-color: transparent;\\n}\\n.ac-bl-card:hover::before { transform: scaleX(1); }\\n/* Revelado al hacer scroll (solo si el JS est\u00e1 activo) */\\n.ac-bl-js .ac-bl-reveal {\\n  opacity: 0;\\n  translate: 0 24px;\\n  transition: opacity 0.6s ease, translate 0.6s ease;\\n}\\n.ac-bl-js .ac-bl-reveal.ac-bl-visible {\\n  opacity: 1;\\n  translate: 0 0;\\n}\\n/* \u2500\u2500 Imagen \u2500\u2500 */\\n.ac-bl-card-img {\\n  display: block;\\n  overflow: hidden;\\n  aspect-ratio: 16 / 10;\\n  background: var(\\u002d\\u002dac-bl-arena);\\n  flex-shrink: 0;\\n}\\n.ac-bl-card-img img {\\n  width: 100%;\\n  height: 100%;\\n  object-fit: cover;\\n  display: block;\\n  transition: transform 0.7s ease;\\n}\\n.ac-bl-card:hover .ac-bl-card-img img { transform: scale(1.05); }\\n.ac-bl-card-img-placeholder {\\n  width: 100%;\\n  height: 100%;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n}\\n.ac-bl-card-img-placeholder svg { width: 48px; height: 48px; opacity: 0.35; }\\n/* \u2500\u2500 Cuerpo \u2500\u2500 */\\n.ac-bl-card-body {\\n  padding: 26px 26px 28px;\\n  display: flex;\\n  flex-direction: column;\\n  flex: 1;\\n}\\n.ac-bl-card-cat {\\n  position: relative;\\n  z-index: 3;\\n  align-self: flex-start;\\n  font-weight: 500;\\n  font-size: 0.65rem;\\n  letter-spacing: 0.2em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  text-decoration: none;\\n  margin-bottom: 12px;\\n  transition: color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-card-cat:hover { color: var(\\u002d\\u002dac-bl-dark); }\\n.ac-bl-card-title {\\n  font-family: 'Playfair Display', serif;\\n  font-weight: 700;\\n  font-style: normal;\\n  font-size: 1.25rem;\\n  line-height: 1.3;\\n  color: var(\\u002d\\u002dac-bl-dark);\\n  margin: 0 0 14px;\\n  padding: 0;\\n}\\n.ac-bl-card-title a {\\n  color: inherit;\\n  text-decoration: none;\\n  transition: color var(\\u002d\\u002dac-bl-trans);\\n}\\n/* Toda la tarjeta clicable */\\n.ac-bl-card-title a::after {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  z-index: 1;\\n}\\n.ac-bl-card:hover .ac-bl-card-title a { color: var(\\u002d\\u002dac-bl-verde); }\\n.ac-bl-card-sep {\\n  width: 28px;\\n  height: 1px;\\n  background: var(\\u002d\\u002dac-bl-arena);\\n  margin-bottom: 14px;\\n  flex-shrink: 0;\\n}\\n.ac-bl-card-excerpt {\\n  font-weight: 300;\\n  font-size: 0.88rem;\\n  line-height: 1.78;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n  margin: 0 0 24px;\\n  padding: 0;\\n  display: -webkit-box;\\n  -webkit-line-clamp: 4;\\n  -webkit-box-orient: vertical;\\n  overflow: hidden;\\n}\\n.ac-bl-card-cta {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-weight: 500;\\n  font-size: 0.68rem;\\n  letter-spacing: 0.18em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  margin-top: auto;\\n  padding-top: 20px;\\n  border-top: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  transition: gap var(\\u002d\\u002dac-bl-trans), color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-card-cta .ac-bl-arrow { transition: transform var(\\u002d\\u002dac-bl-trans); }\\n.ac-bl-card:hover .ac-bl-card-cta { color: var(\\u002d\\u002dac-bl-dark); gap: 12px; }\\n.ac-bl-card:hover .ac-bl-card-cta .ac-bl-arrow { transform: translateX(4px); }\\n/* \u2500\u2500 Art\u00edculo destacado (primero de la p\u00e1gina 1) \u2500\u2500 */\\n.ac-bl-card\\u002d\\u002dfeatured {\\n  grid-column: 1 / -1;\\n  display: grid;\\n  grid-template-columns: 1.25fr 1fr;\\n}\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-img { aspect-ratio: auto; min-height: 380px; height: 100%; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-body { padding: 48px 44px; justify-content: center; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-title { font-size: clamp(1.6rem, 2.6vw, 2.1rem); line-height: 1.22; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-excerpt { font-size: 0.95rem; -webkit-line-clamp: 5; }\\n.ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-cta { margin-top: 28px; }\\n.ac-bl-badge {\\n  display: inline-block;\\n  align-self: flex-start;\\n  font-weight: 500;\\n  font-size: 0.62rem;\\n  letter-spacing: 0.2em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-lino);\\n  background: var(\\u002d\\u002dac-bl-marron);\\n  border-radius: 999px;\\n  padding: 5px 12px;\\n  margin-bottom: 16px;\\n}\\n/* \u2500\u2500 Skeleton de carga \u2500\u2500 */\\n.ac-bl-skeleton {\\n  background: var(\\u002d\\u002dac-bl-white);\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: var(\\u002d\\u002dac-bl-radius);\\n  overflow: hidden;\\n}\\n.ac-bl-skel-img { aspect-ratio: 16 / 10; }\\n.ac-bl-skel-line { height: 12px; margin: 0 26px 12px; border-radius: 4px; }\\n.ac-bl-skel-line:first-of-type { margin-top: 26px; width: 30%; }\\n.ac-bl-skel-line.ac-bl-w80 { width: calc(80% - 52px); height: 18px; }\\n.ac-bl-skel-line.ac-bl-w60 { width: calc(60% - 52px); margin-bottom: 28px; }\\n.ac-bl-skel-img,\\n.ac-bl-skel-line {\\n  background: linear-gradient(90deg, var(\\u002d\\u002dac-bl-arena) 0%, #EFEAE1 50%, var(\\u002d\\u002dac-bl-arena) 100%);\\n  background-size: 200% 100%;\\n  animation: ac-bl-shimmer 1.4s ease-in-out infinite;\\n}\\n@keyframes ac-bl-shimmer {\\n  from { background-position: 100% 0; }\\n  to   { background-position: -100% 0; }\\n}\\n/* \u2500\u2500 Estados vac\u00edo / error \u2500\u2500 */\\n.ac-bl-empty {\\n  grid-column: 1 / -1;\\n  text-align: center;\\n  padding: 72px 24px;\\n  color: var(\\u002d\\u002dac-bl-marron);\\n}\\n.ac-bl-empty p { font-weight: 300; font-size: 0.95rem; line-height: 1.75; margin: 0 0 20px; }\\n/* \u2500\u2500 Paginaci\u00f3n \u2500\u2500 */\\n.ac-bl-pagination {\\n  display: flex;\\n  justify-content: center;\\n  align-items: center;\\n  gap: 8px;\\n  margin-top: 64px;\\n  padding-top: 48px;\\n  border-top: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  flex-wrap: wrap;\\n}\\n.ac-bl-pagination[hidden] { display: none; }\\n.ac-bl-page-btn {\\n  font-family: 'Montserrat', sans-serif;\\n  font-weight: 500;\\n  font-size: 0.7rem;\\n  letter-spacing: 0.15em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-bl-verde);\\n  background: transparent;\\n  border: 1px solid var(\\u002d\\u002dac-bl-arena);\\n  border-radius: 999px;\\n  min-width: 42px;\\n  padding: 11px 18px;\\n  cursor: pointer;\\n  transition: background var(\\u002d\\u002dac-bl-trans), color var(\\u002d\\u002dac-bl-trans), border-color var(\\u002d\\u002dac-bl-trans);\\n}\\n.ac-bl-page-btn:hover,\\n.ac-bl-page-btn[aria-current=\\u0022page\\u0022] {\\n  background: var(\\u002d\\u002dac-bl-verde);\\n  color: var(\\u002d\\u002dac-bl-lino);\\n  border-color: var(\\u002d\\u002dac-bl-verde);\\n}\\n.ac-bl-page-btn:disabled { opacity: 0.35; cursor: default; pointer-events: none; }\\n.ac-bl-page-dots { color: var(\\u002d\\u002dac-bl-marron); padding: 0 4px; }\\n.ac-bl-sr {\\n  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\\n  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;\\n}\\n/* \u2500\u2500 Responsive \u2500\u2500 */\\n@media (max-width: 980px) {\\n  .ac-bl-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }\\n  .ac-bl-card\\u002d\\u002dfeatured { grid-template-columns: 1fr; }\\n  .ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-img { min-height: 0; aspect-ratio: 16 / 9; }\\n  .ac-bl-card\\u002d\\u002dfeatured .ac-bl-card-body { padding: 32px 28px; }\\n}\\n@media (max-width: 640px) {\\n  .ac-bl-grid { grid-template-columns: 1fr; }\\n  .ac-bl-container { padding: 40px 18px 72px; }\\n  .ac-bl-header { padding: 64px 20px 48px; }\\n  .ac-bl-filters { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 0 -18px 36px; padding: 0 18px 6px; scrollbar-width: none; }\\n  .ac-bl-filters::-webkit-scrollbar { display: none; }\\n  .ac-bl-chip { flex-shrink: 0; }\\n  .ac-bl-card-body { padding: 22px 20px 24px; }\\n  .ac-bl-card-title { font-size: 1.15rem; }\\n  .ac-bl-page-btn.ac-bl-txt { padding: 11px 14px; }\\n}\\n@media (prefers-reduced-motion: reduce) {\\n  .ac-bl-page *, .ac-bl-page *::before, .ac-bl-page *::after { animation: none !important; transition: none !important; }\\n  .ac-bl-js .ac-bl-reveal { opacity: 1; translate: 0 0; }\\n}\\n\\u003c/style\\u003e\\n\\n\\u003cdiv class=\\u0022ac-bl-page\\u0022 id=\\u0022ac-bl-page\\u0022\\u003e\\n  \\u003cheader class=\\u0022ac-bl-header\\u0022\\u003e\\n    \\u003cspan class=\\u0022ac-bl-eyebrow\\u0022\\u003eColoraci\u00f3n vegetal \u00b7 M\u00e9todo AMAR\\u003c/span\\u003e\\n    \\u003ch1\\u003eEl Blog de\\u003cbr\\u003e\\u003cem\\u003eAlquimia de Color\\u003c/em\\u003e\\u003c/h1\\u003e\\n    \\u003cp class=\\u0022ac-bl-header-sub\\u0022\\u003eArt\u00edculos honestos sobre plantas, mezclas y el arte de cuidar tu cabello a tu ritmo.\\u003c/p\\u003e\\n    \\u003cdiv class=\\u0022ac-bl-header-line\\u0022 aria-hidden=\\u0022true\\u0022\\u003e\\u003cspan\\u003e\u2726\\u003c/span\\u003e\\u003c/div\\u003e\\n  \\u003c/header\\u003e\\n  \\u003cdiv class=\\u0022ac-bl-container\\u0022\\u003e\\n    \\u003cnav aria-label=\\u0022Filtrar art\u00edculos por categor\u00eda\\u0022\\u003e\\n      \\u003cdiv id=\\u0022ac-bl-filters\\u0022 class=\\u0022ac-bl-filters\\u0022 hidden\\u003e\\u003c/div\\u003e\\n    \\u003c/nav\\u003e\\n    \\u003cp id=\\u0022ac-bl-status\\u0022 class=\\u0022ac-bl-sr\\u0022 aria-live=\\u0022polite\\u0022\\u003e\\u003c/p\\u003e\\n    \\u003cdiv id=\\u0022ac-bl-grid\\u0022 class=\\u0022ac-bl-grid\\u0022 aria-busy=\\u0022true\\u0022\\u003e\\u003c/div\\u003e\\n    \\u003cnav id=\\u0022ac-bl-pagination\\u0022 class=\\u0022ac-bl-pagination\\u0022 aria-label=\\u0022Paginaci\u00f3n del blog\\u0022 hidden\\u003e\\u003c/nav\\u003e\\n  \\u003c/div\\u003e\\n  \\u003cnoscript\\u003e\\n    \\u003cp style=\\u0022text-align:center;padding:0 24px 72px;color:#8C7B6A;\\u0022\\u003eActiva JavaScript para ver los art\u00edculos o visita el \\u003ca href=\\u0022/feed/\\u0022 style=\\u0022color:#4B5332;\\u0022\\u003elistado de entradas\\u003c/a\\u003e.\\u003c/p\\u003e\\n  \\u003c/noscript\\u003e\\n\\u003c/div\\u003e\\n\\n\\u003cscript\\u003e\\n(function () {\\n  /* \u2500\u2500 Configuraci\u00f3n \u2500\u2500 */\\n  var BASE_URL    = window.location.origin;  /* Mismo dominio de la web */\\n  var PER_PAGE    = 7;                        /* 1 destacado + 6 en la p\u00e1gina 1 */\\n  var EXCERPT_LEN = 160;\\n  /* \u2500\u2500 Estado \u2500\u2500 */\\n  var state = { page: 1, cat: 0, totalPages: 1, firstLoad: true, req: 0 };\\n  var categories = {};\\n  /* \u2500\u2500 DOM \u2500\u2500 */\\n  var root       = document.getElementById('ac-bl-page');\\n  var grid       = document.getElementById('ac-bl-grid');\\n  var pagination = document.getElementById('ac-bl-pagination');\\n  var filters    = document.getElementById('ac-bl-filters');\\n  var statusEl   = document.getElementById('ac-bl-status');\\n  if (!root) { return; }\\n  if (!grid) { return; }\\n  var canReveal = 'IntersectionObserver' in window;\\n  if (canReveal) { root.classList.add('ac-bl-js'); }\\n  /* \u2500\u2500 Helpers \u2500\u2500 */\\n  function esc(str) {\\n    return String(str || '').replace(/[\\u0026\\u003c\\u003e\\u0022']/g, function (c) {\\n      return { '\\u0026': '\\u0026amp;', '\\u003c': '\\u0026lt;', '\\u003e': '\\u0026gt;', '\\u0022': '\\u0026quot;', \\u0022'\\u0022: '\\u0026#39;' }[c];\\n    });\\n  }\\n  function decode(html) {\\n    var tmp = document.createElement('textarea');\\n    tmp.innerHTML = html || '';\\n    return tmp.value;\\n  }\\n  function cleanExcerpt(html, max) {\\n    var tmp = document.createElement('div');\\n    tmp.innerHTML = html || '';\\n    var text = (tmp.textContent || '').replace(/\\\\[(\\u0026hellip;|\u2026)\\\\]/g, '').replace(/\\\\s+/g, ' ').trim();\\n    if (text.length \\u003e max) { text = text.substring(0, max).replace(/\\\\s+\\\\S*$/, '') + '\u2026'; }\\n    return text;\\n  }\\n  function getMedia(post) {\\n    var emb = post._embedded || {};\\n    var m = emb['wp:featuredmedia'];\\n    if (!m) { return null; }\\n    if (!m[0]) { return null; }\\n    if (!m[0].source_url) { return null; }\\n    return m[0];\\n  }\\n  function getCat(post) {\\n    var emb = post._embedded || {};\\n    var t = emb['wp:term'];\\n    if (!t) { return null; }\\n    if (!t[0]) { return null; }\\n    return t[0][0] || null;\\n  }\\n  function imgHTML(post, title, featured) {\\n    var m = getMedia(post);\\n    if (!m) {\\n      return '\\u003cdiv class=\\u0022ac-bl-card-img-placeholder\\u0022 aria-hidden=\\u0022true\\u0022\\u003e\\u003csvg viewBox=\\u00220 0 48 48\\u0022 fill=\\u0022none\\u0022 stroke=\\u0022currentColor\\u0022 stroke-width=\\u00221.5\\u0022\\u003e\\u003cpath d=\\u0022M10 38c18 0 28-12 28-28C20 10 10 22 10 38Z\\u0022 stroke-linejoin=\\u0022round\\u0022/\\u003e\\u003cpath d=\\u0022M10 38 26 22\\u0022 stroke-linecap=\\u0022round\\u0022/\\u003e\\u003c/svg\\u003e\\u003c/div\\u003e';\\n    }\\n    var sizes = (m.media_details || {}).sizes || {};\\n    var pick = featured ? (sizes.large || sizes.medium_large) : (sizes.medium_large || sizes.large);\\n    var src = pick ? pick.source_url : m.source_url;\\n    var srcset = [];\\n    ['medium', 'medium_large', 'large', 'full'].forEach(function (k) {\\n      if (sizes[k]) { srcset.push(sizes[k].source_url + ' ' + sizes[k].width + 'w'); }\\n    });\\n    var alt = m.alt_text || title;\\n    return '\\u003cimg src=\\u0022' + esc(src) + '\\u0022' +\\n      (srcset.length ? ' srcset=\\u0022' + esc(srcset.join(', ')) + '\\u0022 sizes=\\u0022' + (featured ? '(max-width: 980px) 100vw, 640px' : '(max-width: 640px) 100vw, (max-width: 980px) 50vw, 360px') + '\\u0022' : '') +\\n      ' alt=\\u0022' + esc(alt) + '\\u0022' + (featured ? ' fetchpriority=\\u0022high\\u0022' : ' loading=\\u0022lazy\\u0022') + ' decoding=\\u0022async\\u0022\\u003e';\\n  }\\n  /* \u2500\u2500 Tarjeta \u2500\u2500 */\\n  function buildCard(post, featured) {\\n    var title   = decode(post.title.rendered);\\n    var url     = post.link;\\n    var excerpt = cleanExcerpt(post.excerpt.rendered, featured ? 260 : EXCERPT_LEN);\\n    var cat     = getCat(post);\\n    var card = document.createElement('article');\\n    card.className = 'ac-bl-card ac-bl-reveal' + (featured ? ' ac-bl-card\\u002d\\u002dfeatured' : '');\\n    card.innerHTML =\\n      '\\u003cdiv class=\\u0022ac-bl-card-img\\u0022\\u003e' + imgHTML(post, title, featured) + '\\u003c/div\\u003e' +\\n      '\\u003cdiv class=\\u0022ac-bl-card-body\\u0022\\u003e' +\\n        (featured ? '\\u003cspan class=\\u0022ac-bl-badge\\u0022\\u003e\u00daltimo art\u00edculo\\u003c/span\\u003e' : '') +\\n        (cat ? '\\u003ca class=\\u0022ac-bl-card-cat\\u0022 href=\\u0022' + esc(cat.link) + '\\u0022\\u003e' + esc(decode(cat.name)) + '\\u003c/a\\u003e' : '') +\\n        '\\u003ch2 class=\\u0022ac-bl-card-title\\u0022\\u003e\\u003ca href=\\u0022' + esc(url) + '\\u0022\\u003e' + esc(title) + '\\u003c/a\\u003e\\u003c/h2\\u003e' +\\n        '\\u003cdiv class=\\u0022ac-bl-card-sep\\u0022\\u003e\\u003c/div\\u003e' +\\n        (excerpt ? '\\u003cp class=\\u0022ac-bl-card-excerpt\\u0022\\u003e' + esc(excerpt) + '\\u003c/p\\u003e' : '') +\\n        '\\u003cspan class=\\u0022ac-bl-card-cta\\u0022 aria-hidden=\\u0022true\\u0022\\u003eLeer art\u00edculo \\u003cspan class=\\u0022ac-bl-arrow\\u0022\\u003e\u2192\\u003c/span\\u003e\\u003c/span\\u003e' +\\n      '\\u003c/div\\u003e';\\n    return card;\\n  }\\n  /* \u2500\u2500 Revelado \u2500\u2500 */\\n  var observer = null;\\n  if (canReveal) {\\n    observer = new IntersectionObserver(function (entries) {\\n      entries.forEach(function (entry) {\\n        if (entry.isIntersecting) {\\n          var el = entry.target;\\n          el.classList.add('ac-bl-visible');\\n          observer.unobserve(el);\\n          setTimeout(function () { el.style.transitionDelay = ''; }, 900);\\n        }\\n      });\\n    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });\\n  }\\n  /* \u2500\u2500 Skeleton \u2500\u2500 */\\n  function showSkeleton() {\\n    var html = '';\\n    for (var i = 0; i \\u003c 6; i++) {\\n      html += '\\u003cdiv class=\\u0022ac-bl-skeleton\\u0022 aria-hidden=\\u0022true\\u0022\\u003e\\u003cdiv class=\\u0022ac-bl-skel-img\\u0022\\u003e\\u003c/div\\u003e\\u003cdiv class=\\u0022ac-bl-skel-line\\u0022\\u003e\\u003c/div\\u003e\\u003cdiv class=\\u0022ac-bl-skel-line ac-bl-w80\\u0022\\u003e\\u003c/div\\u003e\\u003cdiv class=\\u0022ac-bl-skel-line ac-bl-w60\\u0022\\u003e\\u003c/div\\u003e\\u003c/div\\u003e';\\n    }\\n    grid.innerHTML = html;\\n    grid.setAttribute('aria-busy', 'true');\\n  }\\n  /* \u2500\u2500 Render \u2500\u2500 */\\n  function renderPosts(posts) {\\n    grid.innerHTML = '';\\n    grid.setAttribute('aria-busy', 'false');\\n    if (!posts.length) {\\n      grid.innerHTML = '\\u003cdiv class=\\u0022ac-bl-empty\\u0022\\u003e\\u003cp\\u003eTodav\u00eda no hay art\u00edculos publicados.\\u003cbr\\u003eVuelve pronto \u2014 la alquimia est\u00e1 en proceso.\\u003c/p\\u003e\\u003c/div\\u003e';\\n      statusEl.textContent = 'No hay art\u00edculos.';\\n      return;\\n    }\\n    var useFeatured = state.page === 1;\\n    posts.forEach(function (post, i) {\\n      var featured = useFeatured ? i === 0 : false;\\n      var card = buildCard(post, featured);\\n      card.style.transitionDelay = ((i % 3) * 90) + 'ms';\\n      grid.appendChild(card);\\n      if (observer) { observer.observe(card); }\\n    });\\n    statusEl.textContent = 'P\u00e1gina ' + state.page + ' de ' + state.totalPages + ' cargada.';\\n  }\\n  function pageButton(label, page, opts) {\\n    var btn = document.createElement('button');\\n    btn.type = 'button';\\n    btn.className = 'ac-bl-page-btn' + (opts.txt ? ' ac-bl-txt' : '');\\n    btn.innerHTML = label;\\n    if (opts.aria) { btn.setAttribute('aria-label', opts.aria); }\\n    if (opts.current) { btn.setAttribute('aria-current', 'page'); }\\n    if (opts.disabled) { btn.disabled = true; }\\n    btn.addEventListener('click', function () { go(page, state.cat); });\\n    return btn;\\n  }\\n  function renderPagination() {\\n    pagination.innerHTML = '';\\n    var total = state.totalPages;\\n    var cur = state.page;\\n    if (total \\u003c= 1) { pagination.hidden = true; return; }\\n    pagination.hidden = false;\\n    pagination.appendChild(pageButton('\u2190\\u003cspan class=\\u0022ac-bl-sr\\u0022\\u003e Anterior\\u003c/span\\u003e', cur - 1, { txt: true, aria: 'P\u00e1gina anterior', disabled: cur === 1 }));\\n    var last = 0;\\n    for (var p = 1; p \\u003c= total; p++) {\\n      var show = p === 1 || p === total || Math.abs(p - cur) \\u003c= 1;\\n      if (show) {\\n        if (p - last \\u003e 1) {\\n          var dots = document.createElement('span');\\n          dots.className = 'ac-bl-page-dots';\\n          dots.textContent = '\u2026';\\n          pagination.appendChild(dots);\\n        }\\n        pagination.appendChild(pageButton(String(p), p, { current: p === cur, aria: 'P\u00e1gina ' + p }));\\n        last = p;\\n      }\\n    }\\n    pagination.appendChild(pageButton('\\u003cspan class=\\u0022ac-bl-sr\\u0022\\u003eSiguiente \\u003c/span\\u003e\u2192', cur + 1, { txt: true, aria: 'P\u00e1gina siguiente', disabled: cur === total }));\\n  }\\n  function renderError() {\\n    grid.setAttribute('aria-busy', 'false');\\n    grid.innerHTML = '\\u003cdiv class=\\u0022ac-bl-empty\\u0022\\u003e\\u003cp\\u003eNo se han podido cargar los art\u00edculos.\\u003cbr\\u003eInt\u00e9ntalo de nuevo en unos momentos.\\u003c/p\\u003e\\u003cbutton type=\\u0022button\\u0022 class=\\u0022ac-bl-page-btn\\u0022 id=\\u0022ac-bl-retry\\u0022\\u003eReintentar\\u003c/button\\u003e\\u003c/div\\u003e';\\n    var retry = document.getElementById('ac-bl-retry');\\n    if (retry) { retry.addEventListener('click', function () { load(); }); }\\n  }\\n  /* \u2500\u2500 Filtros \u2500\u2500 */\\n  function renderFilters(list) {\\n    var useful = list.filter(function (c) { return c.count \\u003e 0; });\\n    if (useful.length \\u003c 2) { return; }\\n    var html = '\\u003cbutton type=\\u0022button\\u0022 class=\\u0022ac-bl-chip\\u0022 data-cat=\\u00220\\u0022\\u003eTodos\\u003c/button\\u003e';\\n    useful.forEach(function (c) {\\n      categories[c.id] = c;\\n      html += '\\u003cbutton type=\\u0022button\\u0022 class=\\u0022ac-bl-chip\\u0022 data-cat=\\u0022' + c.id + '\\u0022\\u003e' + esc(decode(c.name)) + '\\u003c/button\\u003e';\\n    });\\n    filters.innerHTML = html;\\n    filters.hidden = false;\\n    syncFilters();\\n    filters.addEventListener('click', function (e) {\\n      var btn = e.target.closest('.ac-bl-chip');\\n      if (!btn) { return; }\\n      go(1, parseInt(btn.getAttribute('data-cat'), 10) || 0);\\n    });\\n  }\\n  function syncFilters() {\\n    var chips = filters.querySelectorAll('.ac-bl-chip');\\n    for (var i = 0; i \\u003c chips.length; i++) {\\n      chips[i].setAttribute('aria-pressed', String(parseInt(chips[i].getAttribute('data-cat'), 10) === state.cat));\\n    }\\n  }\\n  /* \u2500\u2500 URL compartible (?pagina=2\\u0026categoria=5) \u2500\u2500 */\\n  function readURL() {\\n    var params = new URLSearchParams(window.location.search);\\n    state.page = Math.max(1, parseInt(params.get('pagina'), 10) || 1);\\n    state.cat  = Math.max(0, parseInt(params.get('categoria'), 10) || 0);\\n  }\\n  function writeURL() {\\n    var params = new URLSearchParams(window.location.search);\\n    if (state.page \\u003e 1) { params.set('pagina', state.page); } else { params.delete('pagina'); }\\n    if (state.cat) { params.set('categoria', state.cat); } else { params.delete('categoria'); }\\n    var qs = params.toString();\\n    history.pushState({ acbl: true }, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);\\n  }\\n  function go(page, cat) {\\n    state.page = page;\\n    state.cat = cat;\\n    writeURL();\\n    syncFilters();\\n    load();\\n  }\\n  window.addEventListener('popstate', function () {\\n    readURL();\\n    syncFilters();\\n    load();\\n  });\\n  /* \u2500\u2500 Carga v\u00eda API REST \u2500\u2500 */\\n  function load() {\\n    var reqId = ++state.req;\\n    if (state.firstLoad) {\\n      state.firstLoad = false;\\n    } else {\\n      var top = root.querySelector('.ac-bl-container').getBoundingClientRect().top + window.pageYOffset - 100;\\n      window.scrollTo({ top: top, behavior: 'smooth' });\\n    }\\n    showSkeleton();\\n    pagination.hidden = true;\\n    var url = BASE_URL + '/wp-json/wp/v2/posts' +\\n      '?per_page=' + (state.page === 1 ? PER_PAGE : PER_PAGE - 1) +\\n      '\\u0026offset=' + (state.page === 1 ? 0 : PER_PAGE + (state.page - 2) * (PER_PAGE - 1)) +\\n      '\\u0026_embed=wp:featuredmedia,wp:term' +\\n      (state.cat ? '\\u0026categories=' + state.cat : '');\\n    fetch(url)\\n      .then(function (res) {\\n        if (!res.ok) { throw new Error('API ' + res.status); }\\n        var total = parseInt(res.headers.get('X-WP-Total') || '0', 10);\\n        state.totalPages = total \\u003c= PER_PAGE ? 1 : 1 + Math.ceil((total - PER_PAGE) / (PER_PAGE - 1));\\n        return res.json();\\n      })\\n      .then(function (posts) {\\n        if (reqId !== state.req) { return; }\\n        if (state.page \\u003e state.totalPages) {\\n          if (state.totalPages \\u003e 0) { go(1, state.cat); return; }\\n        }\\n        renderPosts(posts || []);\\n        renderPagination();\\n      })\\n      .catch(function (err) {\\n        if (reqId !== state.req) { return; }\\n        console.warn('ac-bl: error cargando art\u00edculos \u2192', err);\\n        renderError();\\n      });\\n  }\\n  /* \u2500\u2500 Init \u2500\u2500 */\\n  readURL();\\n  fetch(BASE_URL + '/wp-json/wp/v2/categories?per_page=50\\u0026hide_empty=true\\u0026orderby=count\\u0026order=desc')\\n    .then(function (r) { return r.ok ? r.json() : []; })\\n    .then(renderFilters)\\n    .catch(function () {});\\n  load();\\n})();\\n\\u003c/script\\u003e\\n\"}}},\"builderVersion\":\"5.5.0\"} /-->\r\n<!-- /wp:divi/column -->\r\n<!-- /wp:divi/row -->\r\n<!-- /wp:divi/section --><!-- /wp:divi/placeholder -->"},"presets":null,"global_colors":[["gcid-primary-color",{"color":"#f5f2ed","status":"active","label":"Color Primario"}]],"global_variables":[],"page_settings_meta":{"_et_pb_custom_css":[""]},"canvases":{"local":[],"global":[]},"images":[],"thumbnails":[]}