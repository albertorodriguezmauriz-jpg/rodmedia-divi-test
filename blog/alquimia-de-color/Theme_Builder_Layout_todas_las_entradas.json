{"context":"et_builder","data":{"203":"<!-- wp:divi/placeholder --><!-- wp:divi/section {\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/row {\"module\":{\"advanced\":{\"columnStructure\":{\"desktop\":{\"value\":\"4_4\"}},\"flexColumnStructure\":{\"desktop\":{\"value\":\"equal-columns_1\"}}},\"decoration\":{\"layout\":{\"desktop\":{\"value\":{\"flexWrap\":\"nowrap\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/column {\"module\":{\"advanced\":{\"type\":{\"desktop\":{\"value\":\"4_4\"}}},\"decoration\":{\"sizing\":{\"desktop\":{\"value\":{\"flexType\":\"24_24\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/post-content {\"builderVersion\":\"5.5.0\"} /-->\r\n\r\n<!-- /wp:divi/column -->\r\n<!-- /wp:divi/row -->\r\n<!-- /wp:divi/section --><!-- wp:divi/section {\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/row {\"module\":{\"advanced\":{\"columnStructure\":{\"desktop\":{\"value\":\"4_4\"}},\"flexColumnStructure\":{\"desktop\":{\"value\":\"equal-columns_1\"}}},\"decoration\":{\"layout\":{\"desktop\":{\"value\":{\"flexWrap\":\"nowrap\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/column {\"module\":{\"advanced\":{\"type\":{\"desktop\":{\"value\":\"4_4\"}}},\"decoration\":{\"sizing\":{\"desktop\":{\"value\":{\"flexType\":\"24_24\"}}}}},\"builderVersion\":\"5.5.0\"} -->\r\n<!-- wp:divi/code {\"content\":{\"innerContent\":{\"desktop\":{\"value\":\"\\u003cstyle\\u003e\\n/* \u2500\u2500 Plantilla Todas las entradas: el art\u00edculo ocupa todo el ancho \u2500\u2500 */\\n.et_pb_section:has(\\u003e .et_pb_row \\u003e .et_pb_column \\u003e .et_pb_post_content) { padding: 0 !important; background-color: #F5F2ED !important; }\\n.et_pb_section:has(\\u003e .et_pb_row \\u003e .et_pb_column \\u003e .et_pb_post_content) \\u003e .et_pb_row { width: 100% !important; max-width: none !important; padding: 0 !important; }\\n.et_pb_post_content { margin: 0 !important; }\\n/* \u2500\u2500 Secci\u00f3n de navegaci\u00f3n entre art\u00edculos \u2500\u2500 */\\n.et_pb_section:has(.ac-pn) { background-color: #F5F2ED !important; padding: 0 0 64px !important; }\\n.et_pb_section:has(.ac-pn) \\u003e .et_pb_row { padding: 0 !important; }\\n.et_pb_section:has(.ac-pn[hidden]) { padding: 0 !important; }\\n\\u003c/style\\u003e\\n\\u003cstyle\\u003e\\n.ac-pn {\\n  \\u002d\\u002dac-pn-lino: #F5F2ED;\\n  \\u002d\\u002dac-pn-dark: #2C2C2B;\\n  \\u002d\\u002dac-pn-arena: #E5DED1;\\n  \\u002d\\u002dac-pn-verde: #4B5332;\\n  \\u002d\\u002dac-pn-marron: #8C7B6A;\\n  background: var(\\u002d\\u002dac-pn-arena);\\n  padding: 48px 40px;\\n  font-family: 'Montserrat', sans-serif;\\n}\\n.ac-pn[hidden] { display: none; }\\n.ac-pn * { box-sizing: border-box; }\\n.ac-pn p:empty, .ac-pn br { display: none !important; }\\n.ac-pn-grid {\\n  display: grid;\\n  grid-template-columns: 1fr 1fr;\\n  gap: 40px;\\n}\\n.ac-pn-link {\\n  position: relative;\\n  display: flex;\\n  flex-direction: column;\\n  justify-content: center;\\n  gap: 12px;\\n  min-height: 130px;\\n  background: var(\\u002d\\u002dac-pn-lino);\\n  border: 1px solid rgba(140, 123, 106, 0.2);\\n  border-radius: 6px;\\n  padding: 26px 28px;\\n  text-decoration: none;\\n  overflow: hidden;\\n  transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;\\n}\\n.ac-pn-link::before {\\n  content: '';\\n  position: absolute;\\n  top: 0; left: 0; right: 0;\\n  height: 3px;\\n  background: var(\\u002d\\u002dac-pn-verde);\\n  transform: scaleX(0);\\n  transform-origin: left;\\n  transition: transform 0.35s ease;\\n}\\n.ac-pn-next::before { transform-origin: right; }\\n.ac-pn-link:hover {\\n  transform: translateY(-4px);\\n  box-shadow: 0 12px 30px rgba(44, 44, 43, 0.10);\\n  border-color: transparent;\\n}\\n.ac-pn-link:hover::before { transform: scaleX(1); }\\n.ac-pn-link:focus-visible { outline: 2px solid var(\\u002d\\u002dac-pn-verde); outline-offset: 3px; }\\n.ac-pn-next { text-align: right; grid-column: 2; }\\n.ac-pn-label {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-weight: 500;\\n  font-size: 0.72rem;\\n  letter-spacing: 0.16em;\\n  text-transform: uppercase;\\n  color: var(\\u002d\\u002dac-pn-verde);\\n}\\n.ac-pn-next .ac-pn-label { justify-content: flex-end; }\\n.ac-pn-arrow { transition: transform 0.35s ease; }\\n.ac-pn-prev:hover .ac-pn-arrow { transform: translateX(-4px); }\\n.ac-pn-next:hover .ac-pn-arrow { transform: translateX(4px); }\\n.ac-pn-title {\\n  font-family: 'Playfair Display', serif;\\n  font-weight: 700;\\n  font-style: normal;\\n  font-size: 1.15rem;\\n  line-height: 1.35;\\n  color: var(\\u002d\\u002dac-pn-dark);\\n  transition: color 0.35s ease;\\n}\\n.ac-pn-link:hover .ac-pn-title { color: var(\\u002d\\u002dac-pn-verde); }\\n@media (max-width: 767px) {\\n  .ac-pn { padding: 28px 18px; }\\n  .ac-pn-grid { grid-template-columns: 1fr; gap: 16px; }\\n  .ac-pn-next { grid-column: auto; }\\n  .ac-pn-link { min-height: 0; padding: 22px 20px; }\\n  .ac-pn-title { font-size: 1.05rem; }\\n}\\n@media (prefers-reduced-motion: reduce) {\\n  .ac-pn * { transition: none !important; }\\n}\\n\\u003c/style\\u003e\\n\\u003cnav class=\\u0022ac-pn\\u0022 id=\\u0022ac-pn\\u0022 aria-label=\\u0022Navegaci\u00f3n entre art\u00edculos\\u0022 hidden\\u003e\\n  \\u003cdiv class=\\u0022ac-pn-grid\\u0022 id=\\u0022ac-pn-grid\\u0022\\u003e\\u003c/div\\u003e\\n\\u003c/nav\\u003e\\n\\u003cscript\\u003e\\n(function () {\\n  var box  = document.getElementById('ac-pn');\\n  var grid = document.getElementById('ac-pn-grid');\\n  if (!box) { return; }\\n  /* Si el art\u00edculo ya trae una navegaci\u00f3n manual antigua, no se duplica */\\n  if (document.querySelectorAll('.ac-pn').length \\u003e 1) { return; }\\n  if (/art[i\u00ed]culo (anterior|siguiente)/i.test(document.body.innerText)) { return; }\\n  var match = document.body.className.match(/(?:^|\\\\s)postid-(\\\\d+)(?:\\\\s|$)/);\\n  if (!match) { return; }\\n  var api = window.location.origin + '/wp-json/wp/v2/posts';\\n  var fields = '\\u0026_fields=link,title';\\n  function esc(s) {\\n    return String(s || '').replace(/[\\u0026\\u003c\\u003e\\u0022']/g, function (c) {\\n      return { '\\u0026': '\\u0026amp;', '\\u003c': '\\u0026lt;', '\\u003e': '\\u0026gt;', '\\u0022': '\\u0026quot;', \\u0022'\\u0022: '\\u0026#39;' }[c];\\n    });\\n  }\\n  function decode(html) {\\n    var t = document.createElement('textarea');\\n    t.innerHTML = html || '';\\n    return t.value;\\n  }\\n  function getJSON(url) {\\n    return fetch(url).then(function (r) { return r.ok ? r.json() : []; }).catch(function () { return []; });\\n  }\\n  function card(post, type) {\\n    if (!post) { return ''; }\\n    var isPrev = type === 'prev';\\n    var label = isPrev ? '\\u003cspan class=\\u0022ac-pn-arrow\\u0022\\u003e\u2190\\u003c/span\\u003e Art\u00edculo anterior' : 'Art\u00edculo siguiente \\u003cspan class=\\u0022ac-pn-arrow\\u0022\\u003e\u2192\\u003c/span\\u003e';\\n    return '\\u003ca class=\\u0022ac-pn-link ac-pn-' + type + '\\u0022 href=\\u0022' + esc(post.link) + '\\u0022 rel=\\u0022' + type + '\\u0022\\u003e' +\\n      '\\u003cspan class=\\u0022ac-pn-label\\u0022\\u003e' + label + '\\u003c/span\\u003e' +\\n      '\\u003cspan class=\\u0022ac-pn-title\\u0022\\u003e' + esc(decode(post.title.rendered)) + '\\u003c/span\\u003e' +\\n    '\\u003c/a\\u003e';\\n  }\\n  fetch(api + '/' + match[1] + '?_fields=date')\\n    .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); })\\n    .then(function (cur) {\\n      var date = encodeURIComponent(cur.date);\\n      return Promise.all([\\n        getJSON(api + '?per_page=1\\u0026orderby=date\\u0026order=desc\\u0026before=' + date + '\\u0026exclude=' + match[1] + fields),\\n        getJSON(api + '?per_page=1\\u0026orderby=date\\u0026order=asc\\u0026after=' + date + '\\u0026exclude=' + match[1] + fields)\\n      ]);\\n    })\\n    .then(function (res) {\\n      var prev = res[0][0];\\n      var next = res[1][0];\\n      if (!prev) { if (!next) { return; } }\\n      grid.innerHTML = card(prev, 'prev') + card(next, 'next');\\n      box.hidden = false;\\n    })\\n    .catch(function () {});\\n})();\\n\\u003c/script\\u003e\\n\"}}},\"builderVersion\":\"5.5.0\"} /-->\r\n<!-- /wp:divi/column -->\r\n<!-- /wp:divi/row -->\r\n<!-- /wp:divi/section --><!-- /wp:divi/placeholder -->"},"presets":null,"global_colors":[],"global_variables":[],"page_settings_meta":{"_et_pb_custom_css":[""]},"canvases":{"local":[],"global":[]},"images":[],"thumbnails":[]}